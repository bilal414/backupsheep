# Default-deny the build context. Dockerfile copies only the runtime application
# inputs explicitly, so a new top-level file is excluded until it is reviewed.
**

# Runtime credentials are never build inputs, even if this allowlist changes.
.env
.secrets/

# Build definition and dependency input.
!Dockerfile
!.dockerignore
!requirements.txt
!requirements.lock

# Runtime bootstrap and the non-secret configuration template consumed by
# settings.py. A real .env is never a build input.
!init.sh
!manage.py
!.env_sample

# Runtime Python packages, templates, and committed static source assets.
!apps/
!apps/**
!backupsheep/
!backupsheep/**
!utils/
!utils/**

# Tests and local interpreter output are not runtime dependencies. Excluding
# them reduces executable surface and keeps test canaries/fixtures out of layers.
apps/tests/
apps/**/tests.py
**/__pycache__/
**/*.py[cod]
**/*.pyo

# Defense in depth for credentials or runtime artifacts accidentally created
# inside an otherwise allowlisted source directory.
**/.env
**/.env.*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.kdbx
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.dump
**/*.sql
**/*.log
**/id_rsa*
**/id_ed25519*
**/.aws/
**/.config/gcloud/
**/.ssh/
