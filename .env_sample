# ──────────────────────────────────────────────────────────────────────────────
# BackupSheep configuration. `install.sh` creates the protected `.env` and `.secrets`
# contract for the bundled Compose stack. For a manual installation, follow
# docs/guides/installation.md rather than copying this sample and starting immediately.
# Keys are read at boot; leave optional entries blank rather than deleting the line.
# ──────────────────────────────────────────────────────────────────────────────

# Build or deploy every application role from the same reviewed tag. Production
# operators should set this to an exact release/revision tag, never `latest`.
BACKUPSHEEP_IMAGE=backupsheep:local
# Locally built, digest-rooted PostgreSQL image. The verified installer pins both
# local image tags to the same full source commit and never pulls either tag.
BACKUPSHEEP_POSTGRES_IMAGE=backupsheep-postgres:local
# Locally built no-secret namespace policy image. The verified installer binds it to
# the same immutable source commit as the application/PostgreSQL images.
BACKUPSHEEP_EGRESS_IMAGE=backupsheep-egress:local
# install.sh persists the exact Compose project name and refuses drift on rerun,
# preventing a typo from creating a second stack with empty data volumes.
BACKUPSHEEP_COMPOSE_PROJECT_NAME=''
# Unique 64-character hexadecimal identity for this Compose installation. install.sh
# generates it. For a reviewed manual install, generate it once with
# `python -c "import secrets; print(secrets.token_hex(32))"` and keep it stable so
# project-name collisions fail closed rather than reusing another install's volumes.
BACKUPSHEEP_INSTALLATION_ID=''
# PostgreSQL 18 Alpine/ICU storage generation. install.sh derives the witness from
# the installation identity, project, fixed runtime generation, active logical
# volume, and ICU locale. Never copy or invent these values to adopt an old volume.
BACKUPSHEEP_POSTGRES_STORAGE_GENERATION=''
BACKUPSHEEP_POSTGRES_STORAGE_INTENT=''
BACKUPSHEEP_POSTGRES_STORAGE_WITNESS=''
# Populated only while/after the one-time Debian migration so the detached legacy
# volume remains bound to its exact retained rollback image.
BACKUPSHEEP_POSTGRES_RETIRED_IMAGE_ID=''
# Private host directory populated with the installation's file-backed secrets.
BACKUPSHEEP_SECRETS_DIR='.secrets'
# Generation-3 ownership witness for private source/storage volumes and separate
# database/files ciphertext handoffs. install.sh derives both values; do not invent
# them to bypass migration.
BACKUPSHEEP_STAGING_LAYOUT_INTENT=''
BACKUPSHEEP_STAGING_LAYOUT_WITNESS=''

DJANGO_SERVER='prod'
# Keep false in production. Setting it to anything else (true/1/yes/on) enables Django
# debug mode, which leaks tracebacks/settings on errors — never do that on a public host.
DJANGO_DEBUG=false
# Public host(s) this install answers on. Use a real hostname in production (a comma-
# separated list is allowed, e.g. "backup.example.com,www.example.com"). WARNING: setting
# this to '*' disables Django's Host-header validation (host-header injection / cache
# poisoning / password-reset poisoning). Only use '*' behind a proxy that sets Host.
DJANGO_ALLOWED_HOSTS='localhost,127.0.0.1'
# The stock Compose stack blanks this value and reads `.secrets/django_secret_key`.
# External/PaaS deployments may instead supply a long, stable secret directly.
DJANGO_SECRET_KEY='change-this-key'
DJANGO_SETTINGS_MODULE='backupsheep.settings'
# Set to true ONLY when this install is served over HTTPS (e.g. behind a TLS-terminating
# reverse proxy). Enables Secure cookies, HSTS, and HTTP->HTTPS redirect.
DJANGO_HTTPS=false
# Disabled by default because Django admin uses a separate password-only login that
# does not inherit BackupSheep console MFA. If an operator enables it, restrict the
# route at the reverse proxy or VPN and use a dedicated superuser.
DJANGO_ADMIN_ENABLED=false

# First-run onboarding gate. The first account created through /onboarding becomes the
# instance admin; the install token proves the person running the wizard has access to
# this server. The stock installer supplies `.secrets/onboarding_token`; external/PaaS
# deployments may set a fixed value here for automated installs.
ONBOARDING_INSTALL_TOKEN=''

# Personal API tokens expire after this many seconds. The maximum accepted lifetime is
# 90 days; 2592000 keeps the secure default to 30 days.
API_TOKEN_TTL_SECONDS=2592000
# Browser sessions last at most 12 hours and, by default, lose their client cookie when
# the browser closes. Values above 43200 are rejected at boot. Session cookies are always
# HttpOnly and SameSite=Lax; DJANGO_HTTPS additionally marks them Secure.
SESSION_COOKIE_AGE=43200
SESSION_EXPIRE_AT_BROWSER_CLOSE=true

# Authentication rate limits use the direct REMOTE_ADDR by default. Enable this only
# when every application request crosses a reviewed reverse proxy which OVERWRITES
# X-BackupSheep-Client-IP with the actual client address. List the exact immediate proxy
# IP(s) or CIDR(s) as the application sees them; never list client/public address ranges.
AUTH_THROTTLE_TRUSTED_PROXY_ENABLED=false
AUTH_THROTTLE_TRUSTED_PROXY_NETWORKS=''

# Public URL this install is reached at (used for links, OAuth redirects, CSRF origins).
APP_DOMAIN='localhost:8000'
APP_PROTOCOL='http://'
APP_NAME='BackupSheep'
# Compose publishes the web container on loopback by default. Keep this value for a TLS
# reverse proxy on the same host. Setting 0.0.0.0 is an explicit opt-in to direct network
# exposure and should not be used for production onboarding.
BACKUPSHEEP_BIND_ADDRESS='127.0.0.1'
BACKUPSHEEP_BIND_PORT='8000'

# Bound Docker json-file logs so a noisy worker cannot fill the host filesystem.
DOCKER_LOG_MAX_SIZE='10m'
DOCKER_LOG_MAX_FILE='5'

# Maximum processes per application container. This bounds accidental fork/process
# exhaustion without limiting the bytes or CPU needed by a legitimate large backup.
BACKUPSHEEP_PIDS_LIMIT=512

# Enterprise artifact custody. install.sh creates independent database and files
# keyrings under the protected .secrets directory. Compose mounts each keyring only
# into its matching source/restore worker; no root key or keyring path belongs here.
# Back up both keyrings separately from backup ciphertext: losing either keyring makes
# that lane's BSE1 artifacts cryptographically unrecoverable. install.sh seals the
# generation/witness pair. A direct production deployment must derive generation 1 with
# scripts/manage_artifact_keyring.py policy-witness before importing Django settings.
BACKUPSHEEP_ARTIFACT_ENCRYPTION_MODE='bse1'
BACKUPSHEEP_ARTIFACT_ENTERPRISE_MODE=true
BACKUPSHEEP_ARTIFACT_ALLOW_LEGACY_RESTORE=false
BACKUPSHEEP_ARTIFACT_KEY_PROVIDER='local-file'
BACKUPSHEEP_ARTIFACT_KEY_PROVIDER_GENERATION=''
BACKUPSHEEP_ARTIFACT_KEY_PROVIDER_WITNESS=''
BACKUPSHEEP_ARTIFACT_LOCAL_FILE_KEYRING_PATH=''

# Fail before creating another private or shared artifact when the relevant volume
# cannot retain this reserve. Docker volume quotas/encryption remain host responsibilities.
BACKUPSHEEP_STAGING_MIN_FREE_BYTES=536870912
BACKUPSHEEP_STAGING_MIN_FREE_INODES=1024
BACKUPSHEEP_PRIVATE_MIN_FREE_BYTES=536870912
BACKUPSHEEP_PRIVATE_MIN_FREE_INODES=1024
BACKUPSHEEP_TRANSFER_MIN_FREE_BYTES=536870912
BACKUPSHEEP_TRANSFER_MIN_FREE_INODES=1024
BACKUPSHEEP_RESTORE_TRANSFER_MIN_FREE_BYTES=536870912
BACKUPSHEEP_RESTORE_TRANSFER_MIN_FREE_INODES=1024

# Stock `deny` mode permits only the exact internal PostgreSQL/RabbitMQ peers and
# blocks all outward traffic. Before enabling a role that needs an external source,
# provider or storage endpoint, select `allowlist` and supply the smallest exact
# CIDR:TCP-port tuples plus every provider DNS name and CNAME target. This network
# control is defense in depth, not a resource-aware exfiltration boundary: enterprise
# operations require dedicated/private endpoints or a controlled resource-aware proxy.
# `public` is an explicit compatibility risk opt-in; it is never the stock default.
BACKUPSHEEP_EGRESS_POLICY_GENERATION='2'
BACKUPSHEEP_APP_EGRESS_MODE='deny'
BACKUPSHEEP_APP_EGRESS_ALLOW_IPV4_TCP_ENDPOINTS=''
BACKUPSHEEP_APP_EGRESS_ALLOW_IPV6_TCP_ENDPOINTS=''
BACKUPSHEEP_APP_EGRESS_ALLOW_DNS_NAMES=''
BACKUPSHEEP_CLOUD_EGRESS_MODE='deny'
BACKUPSHEEP_CLOUD_EGRESS_ALLOW_IPV4_TCP_ENDPOINTS=''
BACKUPSHEEP_CLOUD_EGRESS_ALLOW_IPV6_TCP_ENDPOINTS=''
BACKUPSHEEP_CLOUD_EGRESS_ALLOW_DNS_NAMES=''
BACKUPSHEEP_DATABASE_EGRESS_MODE='deny'
BACKUPSHEEP_DATABASE_EGRESS_ALLOW_IPV4_TCP_ENDPOINTS=''
BACKUPSHEEP_DATABASE_EGRESS_ALLOW_IPV6_TCP_ENDPOINTS=''
BACKUPSHEEP_DATABASE_EGRESS_ALLOW_DNS_NAMES=''
BACKUPSHEEP_FILES_EGRESS_MODE='deny'
BACKUPSHEEP_FILES_EGRESS_ALLOW_IPV4_TCP_ENDPOINTS=''
BACKUPSHEEP_FILES_EGRESS_ALLOW_IPV6_TCP_ENDPOINTS=''
BACKUPSHEEP_FILES_EGRESS_ALLOW_DNS_NAMES=''
BACKUPSHEEP_STORAGE_EGRESS_MODE='deny'
BACKUPSHEEP_STORAGE_EGRESS_ALLOW_IPV4_TCP_ENDPOINTS=''
BACKUPSHEEP_STORAGE_EGRESS_ALLOW_IPV6_TCP_ENDPOINTS=''
BACKUPSHEEP_STORAGE_EGRESS_ALLOW_DNS_NAMES=''
BACKUPSHEEP_LOGS_EGRESS_MODE='deny'
BACKUPSHEEP_LOGS_EGRESS_ALLOW_IPV4_TCP_ENDPOINTS=''
BACKUPSHEEP_LOGS_EGRESS_ALLOW_IPV6_TCP_ENDPOINTS=''
BACKUPSHEEP_LOGS_EGRESS_ALLOW_DNS_NAMES=''

# PostgreSQL. Stock Docker initializes with a database-only bootstrap superuser, runs
# migrations as the schema owner, then seals exact grants for app, preflight, Beat and
# every worker lane. Each lane receives only its own file-backed password. DB_USER is a
# compatibility alias for DB_APP_USER outside Compose; never point it at a privileged
# or worker role. PostgreSQL 18 is recommended (14+ supported by Django 6).
BACKUPSHEEP_DATABASE_IDENTITY_GENERATION=''
DB_NAME='backupsheep'
DB_BOOTSTRAP_USER='backupsheep_bootstrap'
DB_MIGRATOR_USER='backupsheep_migrator'
DB_APP_USER='backupsheep_app'
DB_PREFLIGHT_USER='backupsheep_preflight'
DB_BEAT_USER='backupsheep_beat'
DB_CLOUD_USER='backupsheep_cloud'
DB_DATABASE_USER='backupsheep_database'
DB_FILES_USER='backupsheep_files'
DB_STORAGE_USER='backupsheep_storage'
DB_LOGS_USER='backupsheep_logs'
DB_USER='backupsheep_app'
DB_PASSWORD='change-this-password'
DB_HOST='db'
DB_PORT='5432'
# Optional managed-PostgreSQL URL. When set, it overrides DB_NAME/DB_USER/DB_PASSWORD/
# DB_HOST/DB_PORT (for example: postgresql://user:password@host:5432/database).
DATABASE_URL=''
# External PostgreSQL is accepted in production only with full hostname verification and
# an explicit CA bundle. The stock `db` Compose service is the narrow plaintext exception.
DB_SSLMODE=''
DB_SSLROOTCERT=''

# Celery broker for background + scheduled backups. Stock Compose uses independent
# file-backed credentials for app, Beat, preflight and every worker lane; this value
# names the application identity only and the direct password remains blank.
# Managed platforms may instead provide CELERY_BROKER_URL and leave RABBITMQ_HOST blank.
CELERY_BROKER_URL=''
RABBITMQ_HOST='rabbitmq'
RABBITMQ_PORT='5672'
RABBITMQ_SCHEME='amqp'
RABBITMQ_USER='backupsheep_app'
RABBITMQ_PASSWORD=''
RABBITMQ_VHOST='backupsheep'
# Installer-owned identity/task-auth witnesses. Existing stock installs must use the
# explicit broker migration flag; never set these by hand to bypass provisioning.
BACKUPSHEEP_RABBITMQ_IDENTITY_GENERATION=''
BACKUPSHEEP_CELERY_SECURITY_GENERATION=''
BACKUPSHEEP_CELERY_SIGNING_KEY_GENERATION=''
RABBITMQ_LEGACY_USER='backupsheep'
# Installer-owned data-format witness. Leave blank in the sample; install.sh sets 4.3
# only for a new volume or after proving a live broker is already on RabbitMQ 4.3.
BACKUPSHEEP_RABBITMQ_DATA_GENERATION=''
# Optional private CA bundle for amqps. System trust roots are used when this is blank.
RABBITMQ_CA_CERT=''

# Terminal replay identities outlive the seven-day signed message lifetime. Active
# deliveries are never pruned; keep at least 605100 seconds (7 days + clock skew).
CELERY_TASK_REPLAY_RETENTION_SECONDS=1209600
CELERY_TASK_REPLAY_CLEANUP_BATCH_SIZE=1000

# Single-host worker capacity. These conservative defaults target the documented
# starter topology and keep CPU/disk-heavy work visibly queued instead of reserving
# many large jobs at once. Raise one queue at a time only after measuring the host.
CELERY_CLOUD_CONCURRENCY=4
CELERY_CLOUD_PREFETCH_MULTIPLIER=1
CELERY_DATABASE_CONCURRENCY=1
CELERY_DATABASE_PREFETCH_MULTIPLIER=1
CELERY_FILES_CONCURRENCY=1
CELERY_FILES_PREFETCH_MULTIPLIER=1
CELERY_STORAGE_CONCURRENCY=2
CELERY_STORAGE_PREFETCH_MULTIPLIER=1
CELERY_LOGS_CONCURRENCY=2
CELERY_LOGS_PREFETCH_MULTIPLIER=1

# Days to keep backup run logs on local disk before delete_old_logs prunes them.
LOG_RETENTION_DAYS=30

# Crash recovery and renewable execution leases. Keep the heartbeat comfortably
# below one third of the worker lease.
BACKUP_RECOVERY_STALE_SECONDS=900
BACKUP_RECOVERY_BATCH_SIZE=100
BACKUP_REQUEST_RETRY_SECONDS=60
BACKUP_REQUEST_RETRY_MAX_SECONDS=900
BACKUP_REQUEST_CLAIM_TIMEOUT_SECONDS=300
BACKUP_REQUEST_CLAIM_TIMEOUT_MAX_SECONDS=3600
BACKUP_REQUEST_DISPATCH_LEASE_SECONDS=60
BACKUP_REQUEST_RECOVERY_BATCH_SIZE=100
BACKUP_POLL_INTERVAL=120
BACKUP_WORKER_LEASE_SECONDS=180
BACKUP_WORKER_HEARTBEAT_SECONDS=30
BACKUP_DELETE_LEASE_SECONDS=300
STORAGE_POINT_DELETE_LEASE_SECONDS=3600
BACKUP_STORAGE_LEASE_SECONDS=180
BACKUP_STORAGE_HEARTBEAT_SECONDS=30
RESTORE_WORKER_LEASE_SECONDS=180
RESTORE_WORKER_HEARTBEAT_SECONDS=30
RESTORE_RECOVERY_STALE_SECONDS=300
RESTORE_RECOVERY_DISPATCH_LEASE_SECONDS=120
RESTORE_RECOVERY_BATCH_SIZE=100
BACKUP_CREATE_LEASE_SECONDS=3600
BACKUP_STORAGE_STALE_SECONDS=21600

# Seconds before a generated provider-signed backup download URL expires. Five minutes is
# the default and values above the one-hour hard ceiling are rejected at boot.
S3_DOWNLOAD_URL_EXPIRES=300

# Basecamp is unavailable in enterprise/BSE1 mode until it has a complete
# authenticated export or automatic restore workflow. This switch is an explicit
# non-enterprise compatibility opt-in and takes effect only with
# BACKUPSHEEP_ARTIFACT_ENCRYPTION_MODE=legacy-only,
# BACKUPSHEEP_ARTIFACT_ALLOW_LEGACY_RESTORE=true, and enterprise mode disabled.
BASECAMP_INTEGRATION_ENABLED=false

# Plain FTP exposes credentials and backup data on the network. Use SFTP or FTPS.
# Set true only for a reviewed legacy endpoint after explicitly accepting that risk.
ALLOW_INSECURE_FTP=false

# Compatibility-only path for separately reviewed non-stock deployments. Stock
# Compose does not mount this shared file: it stores account-scoped approvals in
# PostgreSQL and materializes only the exact approved keys for each operation.
SSH_KNOWN_HOSTS_PATH='_storage/ssh_known_hosts'
SSH_CONNECT_TIMEOUT=15
SSH_BANNER_TIMEOUT=15
SSH_AUTH_TIMEOUT=15
SSH_KEEPALIVE_SECONDS=30
DATABASE_CONNECT_TIMEOUT=15
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_COMMAND_TIMEOUT=82800
DATABASE_VALIDATION_COMMAND_TIMEOUT=30
SSH_IO_TIMEOUT=30
SSH_DISCOVERY_TIMEOUT_SECONDS=60
SSH_DISCOVERY_MAX_ENTRIES=10000
SSH_DISCOVERY_MAX_NAME_BYTES=4096
SSH_DISCOVERY_MAX_RESULT_BYTES=2097152
SSH_REMOTE_COMMAND_MAX_BYTES=2097152
# Remote DB validation credentials are exclusive 0600 files and are normally
# deleted immediately. A later validation removes exact BackupSheep artifacts
# older than this bound if a worker was hard-killed before cleanup.
SSH_REMOTE_CREDENTIAL_STALE_SECONDS=900
SSH_REMOTE_CREDENTIAL_SWEEP_MAX_ENTRIES=10000
SSH_REMOTE_CREDENTIAL_SWEEP_TIMEOUT_SECONDS=10
MANAGED_SSH_OPERATION_TTL_SECONDS=600
MANAGED_SSH_OPERATION_LEASE_SECONDS=300
MANAGED_SSH_TASK_SOFT_TIME_LIMIT_SECONDS=240
MANAGED_SSH_TASK_TIME_LIMIT_SECONDS=270
SOURCE_ARCHIVE_VERIFY_TIMEOUT_SECONDS=43200
PROVIDER_HTTP_CONNECT_TIMEOUT=10
PROVIDER_HTTP_READ_TIMEOUT=60
PROVIDER_HTTP_MAX_TIMEOUT=300
PROVIDER_HTTP_MAX_RETRIES=4
PROVIDER_HTTP_MAX_POOL_CONNECTIONS=50
PROVIDER_HTTP_BACKOFF_FACTOR=0.5
S3_MULTIPART_THRESHOLD_BYTES=8388608
S3_MULTIPART_PART_SIZE_BYTES=8388608
S3_MULTIPART_TARGET_PARTS=8000
S3_MULTIPART_CHECKPOINT_PARTS=16
S3_MULTIPART_HASH_CHUNK_BYTES=1048576
S3_MULTIPART_NO_PROGRESS_SECONDS=3600
S3_MULTIPART_NO_PROGRESS_RETRY_AFTER_SECONDS=300
DROPBOX_UPLOAD_CHUNK_SIZE_BYTES=8388608
RESTORE_MAX_ARCHIVE_MEMBERS=2100000
RESTORE_MAX_UNCOMPRESSED_BYTES=2199023255552
RESTORE_MAX_COMPRESSION_RATIO=1000
RESTORE_DISK_RESERVE_BYTES=536870912
WEBSITE_RESTORE_INLINE_FILE_LIMIT=1000

# Optional managed SSH authentication uses distinct Ed25519 identities per source
# lane. Put the private halves in `.secrets/ssh_managed_database_private_key` and
# `.secrets/ssh_managed_files_private_key`; the installer derives and canonicalizes
# both public values. Enable both or neither. Runtime paths and the legacy shared
# public setting stay blank in stock Compose.
SSH_MANAGED_PRIVATE_KEY_PATH=''
SSH_MANAGED_PUBLIC_KEY=''
SSH_MANAGED_DATABASE_PUBLIC_KEY=''
SSH_MANAGED_FILES_PUBLIC_KEY=''
SSH_MANAGED_LANE_ISOLATION_REQUIRED='true'

# Optional. Error delivery is enabled only when a DSN is set. Tracing and
# profiling remain off unless deliberately enabled with a bounded 0..1 rate.
# Sentry request bodies, local variables, default PII, and secret-shaped fields
# are suppressed regardless of these sampling values.
SENTRY_DSN=''
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0

# The stock Compose model accepts the optional integration values below from this
# single operator-facing file, then removes them from every container and restores
# only the exact consumer lanes. Do not bypass that boundary with a Compose override:
# container startup rejects another lane's deployment-wide provider credentials.

# Storage to be used for application logs etc. Tested with AWS S3 and Cloudflare R2
S3_ACCESS_KEY_ID=''
S3_SECRET_ACCESS_KEY=''
S3_STORAGE_BUCKET_NAME=''
S3_ENDPOINT_URL=''
S3_SIGNATURE_VERSION='s3v4'

# POSTMARK - Email Service
POSTMARK_API_KEY=''
POSTMARK_DOMAIN=''
POSTMARK_EMAIL=''
POSTMARK_API_URL='https://api.postmarkapp.com'

# AWS SES - Email Service
SES_REGION_NAME='' # Example us-east-1
SES_REGION_ENDPOINT='' #Example: email.us-east-1.amazonaws.com
SES_ACCESS_KEY_ID=''
SES_SECRET_ACCESS_KEY=''

# Mailgun - Email Service
MAILGUN_DOMAIN=''
MAILGUN_EMAIL=''
MAILGUN_API_KEY=''
MAILGUN_API_URL='https://api.mailgun.net/v3'

# Default transactional-email provider. The first-run wizard can set this per-install;
# this is the fallback. Options: postmark, mailgun, ses. (Email can be left unconfigured,
# but then password-reset emails won't send — recover a lost password with
# `manage.py changepassword <email>`.)
EMAIL_PROVIDER='postmark'

# Slack / Telegram notification channels (optional — email notifications work
# without these). Slack: create an app at https://api.slack.com/apps and fill in
# the OAuth url + client credentials. Telegram: TELEGRAM_BOT_KEY is the bot token
# from BotFather. Leave blank to keep the channel disabled.
SLACK_TOKEN_URL=''
SLACK_CLIENT_ID=''
SLACK_CLIENT_SECRET=''
TELEGRAM_BOT_KEY=''

# Dropbox Storage - Create Dropbox App and add keys here.
#Learn more: https://www.dropbox.com/developers/reference/getting-started#app%20console
DROPBOX_APP_KEY=''
DROPBOX_APP_SECRET=''

# pCloud Storage OAuth (only needed to connect pCloud as a storage destination).
# Defaults point at pCloud's public OAuth hosts; fill in id/secret to enable it.
PCLOUD_CLIENT_ID=''
PCLOUD_CLIENT_SECRET=''

# Basecamp source OAuth (only needed to back up Basecamp).
# Register an app at https://launchpad.37signals.com/integrations
BASECAMP_CLIENT_ID=''
BASECAMP_CLIENT_SECRET=''

# OneDrive Storage
MS_CLIENT_ID=''
MS_OBJECT_ID=''
MS_TENANT_ID=''
MS_APPLICATION_ID=''
MS_CLIENT_SECRET_VALUE=''
MS_CLIENT_SECRET_ID=''
MS_OAUTH_ENDPOINT='https://login.microsoftonline.com/common/oauth2/v2.0/authorize'
MS_OAUTH_TOKEN_URL='https://login.microsoftonline.com/common/oauth2/v2.0/token'
MS_REDIRECT_URL='/api/v1/callback/microsoft'
MS_SCOPE='offline_access Files.ReadWrite.All User.Read'
MS_RESPONSE_TYPE='code'
MS_GRAPH_ENDPOINT='https://graph.microsoft.com/v1.0'

# Cloud provider API endpoints (server/volume snapshots).
# Defaults are baked into settings.py; only set these to override a provider's host.
# DIGITALOCEAN_API='https://api.digitalocean.com'
# HETZNER_API='https://api.hetzner.cloud'
# UPCLOUD_API='https://api.upcloud.com/1.3'
# VULTR_API='https://api.vultr.com'
# GOOGLE_COMPUTE_API='https://compute.googleapis.com'
# GOOGLE_RESOURCE_API='https://cloudresourcemanager.googleapis.com'

# DigitalOcean OAuth application (PAT-based connections do not need these).
DIGITALOCEAN_APP_CLIENT_ID=''
DIGITALOCEAN_APP_CLIENT_SECRET=''

# OVH Public Cloud application credentials (required to back up OVH instances/volumes).
# Create an application at the console for your region and fill in the matching pair.
OVH_CA_APP_KEY=''
OVH_CA_APP_SECRET=''
OVH_EU_APP_KEY=''
OVH_EU_APP_SECRET=''
OVH_US_APP_KEY=''
OVH_US_APP_SECRET=''

# GOOGLE Drive Storage
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
