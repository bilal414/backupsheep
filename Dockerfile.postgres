# syntax=docker/dockerfile:1.20.0@sha256:26147acbda4f14c5add9946e2fd2ed543fc402884fd75146bd342a7f6271dc1d

# This is a new, explicitly versioned storage runtime. A Debian/glibc cluster is
# never mounted by this image: Compose uses a distinct named volume and the custom
# entrypoint requires the installation-bound Alpine/ICU storage witness.
FROM postgres:18.6-alpine3.24@sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2

LABEL com.backupsheep.postgres.runtime-generation="18.6-alpine3.24-icu-v1" \
      com.backupsheep.postgres.base-index-digest="sha256:d3e1620b530c944afa6e887d22eb899824da68e19c52024bf98f5220c88a65b2"

RUN set -eux; \
    printf '%s  %s\n' 9c440299ae04a0a79d55b8bf03307036d890a40979d2fb698073c9050d4b20a5 /usr/local/bin/docker-entrypoint.sh \
        | sha256sum -c -; \
    test "$(grep -Fc 'exec gosu postgres "$BASH_SOURCE" "$@"' /usr/local/bin/docker-entrypoint.sh)" = 1; \
    apk add --no-cache 'su-exec=0.3-r0'; \
    apk info -v 2>/dev/null | grep -Fxq 'su-exec-0.3-r0'; \
    sed -i \
        's#exec gosu postgres "$BASH_SOURCE" "$@"#exec su-exec postgres "$BASH_SOURCE" "$@"#' \
        /usr/local/bin/docker-entrypoint.sh; \
    rm -f -- /usr/local/bin/gosu; \
    test "$(grep -Fc 'exec su-exec postgres "$BASH_SOURCE" "$@"' /usr/local/bin/docker-entrypoint.sh)" = 1; \
    ! grep -Fq gosu /usr/local/bin/docker-entrypoint.sh; \
    ! command -v gosu; \
    test ! -e /usr/local/bin/gosu; \
    test -x /sbin/su-exec; \
    test "$(id -u postgres):$(id -g postgres)" = '70:70'

COPY --chmod=0555 deploy/postgres/entrypoint.sh /usr/local/bin/backupsheep-postgres-entrypoint
COPY --chmod=0555 deploy/postgres/storage-witness.sh /usr/local/bin/backupsheep-postgres-storage-witness

# A fresh Docker named volume inherits the image directory ownership, so PostgreSQL
# can initialize and restart without a root bootstrap or Linux capabilities. An
# incorrectly owned imported volume fails closed instead of being repaired silently.
USER 70:70
ENTRYPOINT ["/usr/local/bin/backupsheep-postgres-entrypoint"]
CMD ["postgres"]
