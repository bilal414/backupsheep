# syntax=docker/dockerfile:1.20.0@sha256:26147acbda4f14c5add9946e2fd2ed543fc402884fd75146bd342a7f6271dc1d

# Cosign 3.1.3 is the latest reviewed upstream release, but its published
# binaries were built with vulnerable Go/dependency versions. Rebuild the exact
# signed upstream tag commit with the fixed graph, then pin the complete graph
# and generated module files so a future resolver change fails the build.
FROM --platform=$BUILDPLATFORM golang:1.26.6-alpine3.23@sha256:e57c41c1d5864341031181b0db34b9a537bb5773eb6428e4e5bdaea0f9135406 AS verifier-builder

ARG TARGETOS
ARG TARGETARCH

ENV CGO_ENABLED=0 \
    GOINSECURE= \
    GONOSUMDB= \
    GOPRIVATE= \
    GOPROXY=https://proxy.golang.org \
    GOSUMDB=sum.golang.org \
    GOTOOLCHAIN=local

WORKDIR /src

RUN set -eux; \
    wget -q -O /tmp/cosign.tar.gz \
        'https://codeload.github.com/sigstore/cosign/tar.gz/11926fa5bbbbde47e88fc006b625a17769b743b2'; \
    printf '%s  %s\n' \
        3a718446bac51466efff6853639e1ca108b456ecbf07cd92938f548715d22d6b \
        /tmp/cosign.tar.gz | sha256sum -c -; \
    tar -xzf /tmp/cosign.tar.gz --strip-components=1; \
    rm -f /tmp/cosign.tar.gz; \
    go mod edit -require=golang.org/x/mod@v0.40.0; \
    go mod edit -require=golang.org/x/text@v0.40.0; \
    go mod edit -require=google.golang.org/grpc@v1.82.1; \
    go mod download all; \
    printf '%s  %s\n' \
        08c04f8b38f15378ca82f73a61ca93c459170c6b8507452a0be22ebfb80aa065 go.mod \
        65543888ecf6d9b1578adf0bb2fe5aa046f0216a905189fdb42152a224ef5464 go.sum \
        | sha256sum -c -; \
    test "$(go list -mod=readonly -m all | LC_ALL=C sort | sha256sum | cut -d ' ' -f 1)" = \
        894396e4119d1620852793d03419a7130f4c62881ae5e11301b36c2a775aa6f2; \
    test "$TARGETOS" = linux; \
    case "$TARGETARCH" in amd64|arm64) ;; *) exit 1 ;; esac; \
    GOOS="$TARGETOS" GOARCH="$TARGETARCH" \
        go build -mod=readonly -trimpath -buildvcs=false \
        -ldflags '-buildid= -s -w -X sigs.k8s.io/release-utils/version.gitVersion=v3.1.3-backupsheep.1 -X sigs.k8s.io/release-utils/version.gitCommit=11926fa5bbbbde47e88fc006b625a17769b743b2 -X sigs.k8s.io/release-utils/version.gitTreeState=patched -X sigs.k8s.io/release-utils/version.buildDate=2026-08-29T00:00:00Z' \
        -o /out/cosign ./cmd/cosign; \
    test -x /out/cosign

FROM scratch

LABEL org.opencontainers.image.title="BackupSheep release verifier" \
      org.opencontainers.image.description="Minimal Cosign verifier rebuilt with reviewed security updates" \
      org.opencontainers.image.source="https://github.com/bilal414/backupsheep" \
      org.opencontainers.image.licenses="Apache-2.0" \
      com.backupsheep.release-verifier.upstream-version="v3.1.3" \
      com.backupsheep.release-verifier.upstream-commit="11926fa5bbbbde47e88fc006b625a17769b743b2" \
      com.backupsheep.release-verifier.go-version="go1.26.6" \
      com.backupsheep.release-verifier.module-graph-sha256="894396e4119d1620852793d03419a7130f4c62881ae5e11301b36c2a775aa6f2"

COPY --link --from=verifier-builder --chown=0:0 --chmod=a=r \
    /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --link --from=verifier-builder --chown=0:0 --chmod=a=rx \
    /out/cosign /ko-app/cosign

ENV HOME=/tmp

USER 65532:65532
ENTRYPOINT ["/ko-app/cosign"]
