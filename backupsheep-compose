#!/bin/bash
# Execute the reviewed BackupSheep Compose model without ambient interpolation.
set -euo pipefail
umask 077
# Keep every security grammar byte-oriented and immune to locale-specific range
# collation (for example, locales where [a-z] also matches uppercase bytes).
export LC_ALL=C

die() {
    printf '%s\n' "BackupSheep Compose refused: $*" >&2
    exit 64
}

root_install_mode_allowed() {
    local effective_uid="$1"
    local approved_override="$2"

    [[ "$effective_uid" =~ ^[0-9]+$ ]] || return 1
    if (( 10#$effective_uid == 0 )); then
        [[ "$approved_override" == true ]]
    else
        [[ "$approved_override" == false ]]
    fi
}

allow_root_install=false
if [[ "${1-}" == "--allow-root-install" ]]; then
    allow_root_install=true
    shift
    [[ "${1-}" != "--allow-root-install" ]] \
        || die "--allow-root-install may be specified only once."
fi
if ! root_install_mode_allowed "$EUID" "$allow_root_install"; then
    if (( EUID == 0 )); then
        die "effective UID 0 is refused by default; put --allow-root-install first only for an intentionally root-owned installation."
    fi
    die "--allow-root-install is valid only when the effective invoking UID is 0; omit it for a non-root installation."
fi
if (( EUID == 0 )); then
    # A privileged wrapper must not resolve Docker or file utilities through a
    # user-writable command lookup path inherited from sudo or a login shell.
    export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
fi

valid_compose_project_name() {
    local value="$1"
    local LC_ALL=C
    [[ "$value" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]]
}

script_path="${BASH_SOURCE[0]}"
[[ -f "$script_path" && ! -L "$script_path" ]] \
    || die "the wrapper must be invoked as a regular, non-symlink file."
root_dir="$(cd -- "$(dirname -- "$script_path")" && pwd -P)"
installation_parent="$(dirname -- "$root_dir")"
install_path_regex='^/[A-Za-z0-9._/@+ -]+$'
[[ "$root_dir" != *','* && "$root_dir" != *'|'* && "$root_dir" != *[[:cntrl:]]* ]] \
    || die "installation paths containing commas, pipes, or control characters are not supported."
[[ "$root_dir" =~ $install_path_regex ]] \
    || die "the installation path contains characters outside the reviewed Docker mount and attestation grammar."
env_file="${root_dir}/.env"
base_file="${root_dir}/docker-compose.yml"
default_override="${root_dir}/docker-compose.override.yml"
rabbitmq_upgrade="${root_dir}/deploy/rabbitmq/upgrade-4.2.9.compose.yml"
release_overlay="${root_dir}/deploy/release/signed-release.compose.yml"
runtime_json_parser="${root_dir}/deploy/runtime/compose-json.awk"
release_evidence_dir="${root_dir}/.release-evidence"
mutation_lock_dir="${root_dir}.backupsheep-mutation-lock"
mutation_lock_owner_file="${mutation_lock_dir}/owner"
mutation_lock_token=""
mutation_lock_held=false
legacy_rabbitmq_image_defaults_unavailable=false
active_compose_pid=""

file_uid() {
    stat -c '%u' "$1" 2>/dev/null || stat -f '%u' "$1"
}

file_mode() {
    stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"
}

file_links() {
    stat -c '%h' "$1" 2>/dev/null || stat -f '%l' "$1"
}

file_size() {
    stat -c '%s' "$1" 2>/dev/null || stat -f '%z' "$1"
}

file_identity() {
    stat -c '%d:%i' "$1" 2>/dev/null || stat -f '%d:%i' "$1"
}

validate_installation_ancestor_chain() {
    local current="$1" parent="" mode="" owner=""
    while :; do
        [[ -d "$current" && ! -L "$current" ]] \
            || die "installation path ancestor must be a real directory: ${current}."
        mode="$(file_mode "$current")"
        owner="$(file_uid "$current")"
        [[ "$mode" =~ ^[0-7]{3,4}$ && "$owner" =~ ^[0-9]+$ ]] \
            || die "could not attest installation path ancestor: ${current}."
        if (( EUID == 0 )); then
            (( 10#$owner == 0 )) \
                || die "a root invocation requires every installation path ancestor to be root-owned: ${current}."
        else
            (( 10#$owner == EUID || 10#$owner == 0 )) \
                || die "installation path ancestor is owned by an unrelated account: ${current}."
        fi
        if (( (8#$mode & 8#022) != 0 )); then
            (( (8#$mode & 8#1000) != 0 && 10#$owner == 0 )) \
                || die "installation path ancestor is attacker-writable without a root-owned sticky boundary: ${current}."
        fi
        [[ "$current" == / ]] && break
        parent="$(dirname -- "$current")"
        [[ "$parent" != "$current" ]] || die "could not walk installation path ancestors."
        current="$parent"
    done
}

installation_ancestor_snapshot() {
    local current="$1" parent="" identity="" owner="" mode=""
    while :; do
        [[ -d "$current" && ! -L "$current" ]] || return 1
        identity="$(file_identity "$current")" || return 1
        owner="$(file_uid "$current")" || return 1
        mode="$(file_mode "$current")" || return 1
        [[ "$identity" =~ ^[0-9]+:[0-9]+$ && "$owner" =~ ^[0-9]+$ \
            && "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
        printf '%s|%s|%s|%s\n' "$current" "$identity" "$owner" "$mode"
        [[ "$current" == / ]] && break
        parent="$(dirname -- "$current")"
        [[ "$parent" != "$current" ]] || return 1
        current="$parent"
    done
}

assert_installation_ancestor_identity() {
    local current_snapshot=""
    current_snapshot="$(installation_ancestor_snapshot "$root_dir")" \
        || die "could not re-attest the full installation path ancestor chain."
    [[ "$current_snapshot" == "$installation_ancestor_identity" ]] \
        || die "installation path ancestor identity or permissions changed during validation."
}

assert_installation_root_identity() {
    [[ -d "$root_dir" && ! -L "$root_dir" \
        && "$(file_identity "$root_dir")" == "$installation_root_identity" ]] \
        || die "installation directory identity changed during validation."
}

release_mutation_lock() {
    local release_failed=false

    [[ "$mutation_lock_held" == true ]] || return 0
    if [[ ! -d "$mutation_lock_dir" || -L "$mutation_lock_dir" \
          || "$(file_uid "$mutation_lock_dir")" != "$EUID" \
          || "$(file_mode "$mutation_lock_dir")" != "700" \
          || ! -f "$mutation_lock_owner_file" || -L "$mutation_lock_owner_file" \
          || "$(file_uid "$mutation_lock_owner_file")" != "$EUID" \
          || "$(file_mode "$mutation_lock_owner_file")" != "600" \
          || "$(file_links "$mutation_lock_owner_file")" != "1" \
          || "$(<"$mutation_lock_owner_file")" != "$mutation_lock_token" ]]; then
        release_failed=true
    elif ! rm -f -- "$mutation_lock_owner_file" \
        || ! rmdir -- "$mutation_lock_dir"; then
        release_failed=true
    fi
    mutation_lock_held=false
    if [[ "$release_failed" == true ]]; then
        printf '%s\n' \
            "BackupSheep Compose warning: the mutation lock could not be released safely; inspect ${mutation_lock_dir} before another mutation." >&2
        return 1
    fi
    return 0
}

finish_wrapper() {
    local original_status=$?
    trap - HUP INT TERM EXIT
    if ! release_mutation_lock; then
        exit 74
    fi
    exit "$original_status"
}

terminate_active_compose_group() {
    local pid="${active_compose_pid:-}" grace=0 own_pgid=""
    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || { active_compose_pid=""; return 0; }
    own_pgid="$(ps -o pgid= -p $$ 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ "$pid" == "$own_pgid" ]]; then
        printf '%s\n' "BackupSheep Compose warning: refusing to signal the wrapper's own process group." >&2
        active_compose_pid=""
        return 1
    fi
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    while kill -0 -- "-$pid" 2>/dev/null && (( grace < 5 )); do
        sleep 1
        grace=$((grace + 1))
    done
    kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    active_compose_pid=""
}

handle_wrapper_signal() {
    local interrupted_status="$1"
    trap - HUP INT TERM EXIT
    terminate_active_compose_group || true
    release_mutation_lock >/dev/null 2>&1 || true
    exit "$interrupted_status"
}

run_compose_in_isolated_group() {
    local child_pgid="" child_state="" own_pgid="" status=0
    set -m
    "$@" &
    active_compose_pid=$!
    set +m
    child_pgid="$(ps -o pgid= -p "$active_compose_pid" 2>/dev/null | tr -d '[:space:]' || true)"
    own_pgid="$(ps -o pgid= -p $$ 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ "$child_pgid" != "$active_compose_pid" || "$child_pgid" == "$own_pgid" ]]; then
        child_state="$(ps -o stat= -p "$active_compose_pid" 2>/dev/null | tr -d '[:space:]' || true)"
        if ! kill -0 "$active_compose_pid" 2>/dev/null || [[ -z "$child_state" || "$child_state" == Z* ]]; then
            if wait "$active_compose_pid"; then status=0; else status=$?; fi
            active_compose_pid=""
            return "$status"
        fi
        terminate_active_compose_group || true
        die "could not isolate the Compose client in a dedicated process group."
    fi
    if wait "$active_compose_pid"; then status=0; else status=$?; fi
    active_compose_pid=""
    return "$status"
}

acquire_mutation_lock() {
    command -v mkdir >/dev/null 2>&1 && command -v rmdir >/dev/null 2>&1 \
        || die "mkdir and rmdir are required for the portable mutation lock."
    if ! mkdir "$mutation_lock_dir" 2>/dev/null; then
        die "another installer/wrapper mutation is active, or a stale fail-closed lock remains at ${mutation_lock_dir}. Verify that no BackupSheep mutation is running before removing that exact lock manually."
    fi
    mutation_lock_held=true
    trap finish_wrapper EXIT
    trap 'handle_wrapper_signal 129' HUP
    trap 'handle_wrapper_signal 130' INT
    trap 'handle_wrapper_signal 143' TERM
    mutation_lock_token="version=1;tool=backupsheep-compose;pid=$$;uid=${EUID}"
    chmod 0700 "$mutation_lock_dir" \
        || die "could not protect the new mutation lock directory."
    if ! printf '%s\n' "$mutation_lock_token" > "$mutation_lock_owner_file" \
        || ! chmod 0600 "$mutation_lock_owner_file"; then
        die "could not publish the mutation-lock ownership witness."
    fi
    [[ -d "$mutation_lock_dir" && ! -L "$mutation_lock_dir" \
        && "$(file_uid "$mutation_lock_dir")" == "$EUID" \
        && "$(file_mode "$mutation_lock_dir")" == "700" \
        && -f "$mutation_lock_owner_file" && ! -L "$mutation_lock_owner_file" \
        && "$(file_uid "$mutation_lock_owner_file")" == "$EUID" \
        && "$(file_mode "$mutation_lock_owner_file")" == "600" \
        && "$(file_links "$mutation_lock_owner_file")" == "1" \
        && "$(<"$mutation_lock_owner_file")" == "$mutation_lock_token" ]] \
        || die "the new mutation-lock ownership witness failed validation."
}

validate_private_file() {
    local path="$1"
    local label="$2"
    local mode=""

    [[ -f "$path" && ! -L "$path" ]] \
        || die "${label} must be a regular, non-symlink file."
    [[ "$(file_uid "$path")" == "$EUID" ]] \
        || die "${label} must be owned by the effective invoking UID."
    [[ "$(file_links "$path")" == "1" ]] \
        || die "${label} must not be hard-linked."
    [[ "$(file_size "$path")" -le 1048576 ]] \
        || die "${label} is unexpectedly large."
    mode="$(file_mode "$path")"
    [[ "$mode" =~ ^[0-7]{3,4}$ ]] \
        || die "could not validate permissions for ${label}."
    (( (8#$mode & 8#022) == 0 )) \
        || die "${label} must not be writable by group or other users."
}

validate_private_directory() {
    local path="$1"
    local label="$2"
    local mode=""

    [[ -d "$path" && ! -L "$path" ]] \
        || die "${label} must be a real, non-symlink directory."
    [[ "$(file_uid "$path")" == "$EUID" ]] \
        || die "${label} must be owned by the effective invoking UID."
    mode="$(file_mode "$path")"
    [[ "$mode" =~ ^[0-7]{3,4}$ ]] \
        || die "could not validate permissions for ${label}."
    (( (8#$mode & 8#022) == 0 )) \
        || die "${label} must not be writable by group or other users."
}

validate_privileged_runtime_environment() {
    local path=""
    local variable=""

    (( EUID == 0 )) || return 0
    for variable in HOME DOCKER_CONFIG DOCKER_CERT_PATH; do
        path="${!variable-}"
        if [[ "$variable" != HOME && -z "$path" ]]; then
            continue
        fi
        [[ "$path" == /* ]] \
            || die "root-owned wrapper use requires ${variable} to be an absolute path; use a root login environment (for example sudo -H)."
        validate_private_directory "$path" "privileged ${variable} directory"
    done
}

validate_privileged_runtime_environment
validate_installation_ancestor_chain "$root_dir"
installation_ancestor_identity="$(installation_ancestor_snapshot "$root_dir")" \
    || die "could not capture the full installation path ancestor chain."
installation_root_identity="$(file_identity "$root_dir")"
[[ "$installation_root_identity" =~ ^[0-9]+:[0-9]+$ ]] \
    || die "could not capture the installation directory identity."
assert_installation_ancestor_identity
assert_installation_root_identity
validate_private_directory "$installation_parent" "installation parent"
validate_private_directory "$root_dir" "installation directory"
validate_private_file "$script_path" "backupsheep-compose wrapper"
validate_private_file "$env_file" ".env"
validate_private_file "$base_file" "docker-compose.yml"
validate_private_file "$runtime_json_parser" "reviewed Compose JSON parser"
[[ "$(file_mode "$env_file")" == "600" ]] \
    || die ".env must have mode 0600."

if IFS= read -r -d '' _nul_probe < "$env_file"; then
    die ".env contains a NUL byte."
fi
! grep -q $'\r' "$env_file" || die ".env contains carriage returns."
awk '
    /^[[:space:]]*($|#)/ { next }
    $0 !~ /^[A-Za-z_][A-Za-z0-9_]*=/ { exit 2 }
    {
        key = $0
        sub(/=.*/, "", key)
        if (seen[key]++) { exit 3 }
    }
' "$env_file" || die ".env has malformed or duplicate keys."
! grep -Eq '^(COMPOSE_[A-Za-z0-9_]*|BUILDX_[A-Za-z0-9_]*|BUILDKIT_[A-Za-z0-9_]*|DOCKER_BUILDKIT|DOCKER_DEFAULT_PLATFORM|DOCKER_HOST|DOCKER_CONTEXT|BACKUPSHEEP_SECRETS)=' "$env_file" \
    || die ".env contains a forbidden Docker/Compose control or replacement variable."

unquote_env_value() {
    local raw="$1"
    case "$raw" in
        \'*\') raw="${raw#\'}"; raw="${raw%\'}" ;;
        \"*\") raw="${raw#\"}"; raw="${raw%\"}" ;;
    esac
    printf '%s' "$raw"
}

read_env_value() {
    local key="$1"
    local raw=""
    raw="$(awk -F= -v wanted="$key" '$1 == wanted { print substr($0, index($0, "=") + 1); exit }' "$env_file")"
    unquote_env_value "$raw"
}

env_value_or_default() {
    local key="$1" default_value="$2" value=""
    value="$(read_env_value "$key")"
    [[ -n "$value" ]] || value="$default_value"
    printf '%s' "$value"
}

validate_integer_setting() {
    local key="$1" default_value="$2" minimum="$3" maximum="$4" value=""
    value="$(env_value_or_default "$key" "$default_value")"
    [[ "$value" =~ ^(0|[1-9][0-9]{0,8})$ ]] \
        || die "${key} must be a canonical decimal integer."
    (( 10#$value >= minimum && 10#$value <= maximum )) \
        || die "${key} is outside its reviewed resource range."
}

validate_size_setting() {
    local key="$1" default_value="$2" minimum_bytes="$3" maximum_bytes="$4"
    local value="" magnitude="" unit="" multiplier=0 bytes=0
    value="$(env_value_or_default "$key" "$default_value")"
    [[ "$value" =~ ^([1-9][0-9]{0,7})([kKmMgG])$ ]] \
        || die "${key} must be an integer size with a single k, m, or g suffix."
    magnitude="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]}"
    case "$unit" in
        k|K) multiplier=1024 ;;
        m|M) multiplier=1048576 ;;
        g|G) multiplier=1073741824 ;;
        *) die "${key} has an unsupported size suffix." ;;
    esac
    bytes=$((10#$magnitude * multiplier))
    (( bytes >= minimum_bytes && bytes <= maximum_bytes )) \
        || die "${key} is outside its reviewed resource range."
}

validate_cpu_setting() {
    local key="$1" default_value="$2" value=""
    value="$(env_value_or_default "$key" "$default_value")"
    [[ "$value" =~ ^([0-9]|[1-5][0-9]|6[0-4])(\.[0-9]{1,3})?$ \
        && "$value" != 0 && "$value" != 0.0 && "$value" != 0.00 && "$value" != 0.000 \
        && ! "$value" =~ ^64\.[0-9]*[1-9][0-9]*$ ]] \
        || die "${key} must be a canonical CPU value greater than zero and no more than 64."
}

validate_duration_setting() {
    local key="$1" default_value="$2" value="" magnitude="" unit="" seconds=0
    value="$(env_value_or_default "$key" "$default_value")"
    [[ "$value" =~ ^([1-9][0-9]{0,3})([smh])$ ]] \
        || die "${key} must be a canonical nonzero duration in seconds, minutes, or hours."
    magnitude="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]}"
    case "$unit" in
        s) seconds=$((10#$magnitude)) ;;
        m) seconds=$((10#$magnitude * 60)) ;;
        h) seconds=$((10#$magnitude * 3600)) ;;
    esac
    (( seconds >= 1 && seconds <= 3600 )) \
        || die "${key} is outside its reviewed resource range."
}

model_duration_seconds() {
    local key="$1" default_value="$2" value="" magnitude="" unit="" seconds=0
    value="$(env_value_or_default "$key" "$default_value")"
    [[ "$value" =~ ^([1-9][0-9]{0,3})([smh])$ ]] \
        || die "${key} must be a canonical nonzero duration in seconds, minutes, or hours."
    magnitude="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]}"
    case "$unit" in
        s) seconds=$((10#$magnitude)) ;;
        m) seconds=$((10#$magnitude * 60)) ;;
        h) seconds=$((10#$magnitude * 3600)) ;;
        *) die "${key} has an unsupported duration suffix." ;;
    esac
    (( seconds >= 1 && seconds <= 3600 )) \
        || die "${key} is outside its reviewed resource range."
    printf '%s' "$seconds"
}

compose_duration_for_seconds() {
    local seconds="$1"
    [[ "$seconds" =~ ^[1-9][0-9]{0,3}$ ]] \
        || die "could not canonicalize a malformed reviewed duration."
    if (( 10#$seconds % 3600 == 0 )); then
        printf '%sh0m0s' "$((10#$seconds / 3600))"
    elif (( 10#$seconds % 60 == 0 )); then
        printf '%sm0s' "$((10#$seconds / 60))"
    else
        printf '%ss' "$seconds"
    fi
}

validate_compose_model_settings() {
    local key="" default_value=""
    validate_integer_setting BACKUPSHEEP_BIND_PORT 8000 1 65535
    validate_integer_setting BACKUPSHEEP_PIDS_LIMIT 512 32 4096
    validate_integer_setting POSTGRES_PIDS_LIMIT 256 32 4096
    validate_integer_setting RABBITMQ_PIDS_LIMIT 512 32 4096
    validate_integer_setting DOCKER_LOG_MAX_FILE 5 1 20

    validate_size_setting DOCKER_LOG_MAX_SIZE 10m 1048576 1073741824
    validate_size_setting BACKUPSHEEP_TMPFS_SIZE 256m 16777216 2147483648
    validate_size_setting POSTGRES_TMPFS_SIZE 128m 16777216 2147483648
    validate_size_setting RABBITMQ_TMPFS_SIZE 128m 16777216 2147483648
    validate_size_setting POSTGRES_SHM_SIZE 256m 16777216 8589934592
    for key in POSTGRES_MEMORY_LIMIT RABBITMQ_MEMORY_LIMIT DB_PROVISION_MEMORY_LIMIT \
        MIGRATE_MEMORY_LIMIT DB_SEAL_MEMORY_LIMIT PREFLIGHT_MEMORY_LIMIT \
        APP_MEMORY_LIMIT WORKER_CLOUD_MEMORY_LIMIT WORKER_DATABASE_MEMORY_LIMIT \
        WORKER_FILES_MEMORY_LIMIT WORKER_STORAGE_MEMORY_LIMIT \
        WORKER_LOGS_MEMORY_LIMIT BEAT_MEMORY_LIMIT; do
        case "$key" in
            POSTGRES_MEMORY_LIMIT|APP_MEMORY_LIMIT|MIGRATE_MEMORY_LIMIT|WORKER_DATABASE_MEMORY_LIMIT|WORKER_FILES_MEMORY_LIMIT|WORKER_STORAGE_MEMORY_LIMIT) default_value=2g ;;
            RABBITMQ_MEMORY_LIMIT|DB_SEAL_MEMORY_LIMIT|PREFLIGHT_MEMORY_LIMIT|WORKER_CLOUD_MEMORY_LIMIT) default_value=1g ;;
            *) default_value=512m ;;
        esac
        validate_size_setting "$key" "$default_value" 67108864 68719476736
    done

    for key in POSTGRES_CPU_LIMIT RABBITMQ_CPU_LIMIT DB_PROVISION_CPU_LIMIT \
        MIGRATE_CPU_LIMIT DB_SEAL_CPU_LIMIT PREFLIGHT_CPU_LIMIT APP_CPU_LIMIT \
        WORKER_CLOUD_CPU_LIMIT WORKER_DATABASE_CPU_LIMIT WORKER_FILES_CPU_LIMIT \
        WORKER_STORAGE_CPU_LIMIT WORKER_LOGS_CPU_LIMIT BEAT_CPU_LIMIT; do
        case "$key" in
            POSTGRES_CPU_LIMIT|MIGRATE_CPU_LIMIT|APP_CPU_LIMIT|WORKER_CLOUD_CPU_LIMIT|WORKER_DATABASE_CPU_LIMIT|WORKER_FILES_CPU_LIMIT|WORKER_STORAGE_CPU_LIMIT) default_value=2.0 ;;
            RABBITMQ_CPU_LIMIT|DB_SEAL_CPU_LIMIT|PREFLIGHT_CPU_LIMIT|WORKER_LOGS_CPU_LIMIT) default_value=1.0 ;;
            *) default_value=0.5 ;;
        esac
        validate_cpu_setting "$key" "$default_value"
    done

    validate_duration_setting BACKUPSHEEP_STOP_GRACE_PERIOD 5m
    validate_duration_setting POSTGRES_STOP_GRACE_PERIOD 1m
    validate_duration_setting RABBITMQ_STOP_GRACE_PERIOD 3m
}

model_size_bytes() {
    local key="$1" default_value="$2" value="" magnitude="" unit="" multiplier=0
    value="$(env_value_or_default "$key" "$default_value")"
    [[ "$value" =~ ^([1-9][0-9]{0,7})([kKmMgG])$ ]] || return 1
    magnitude="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]}"
    case "$unit" in
        k|K) multiplier=1024 ;;
        m|M) multiplier=1048576 ;;
        g|G) multiplier=1073741824 ;;
        *) return 1 ;;
    esac
    printf '%s' "$((10#$magnitude * multiplier))"
}

model_cpu_nanos() {
    local key="$1" default_value="$2" value="" whole="" fraction=""
    value="$(env_value_or_default "$key" "$default_value")"
    whole="${value%%.*}"
    if [[ "$value" == *.* ]]; then fraction="${value#*.}"; else fraction=""; fi
    while (( ${#fraction} < 9 )); do fraction+="0"; done
    fraction="${fraction:0:9}"
    [[ -n "$fraction" ]] || fraction=0
    printf '%s' "$((10#$whole * 1000000000 + 10#$fraction))"
}

validate_container_mount_policy() {
    local service="$1" container_id="$2" mounts="" mount_type="" mount_name="" source="" destination="" rw="" propagation="" mount_mode=""
    local logical="" expected_rw="" mount_count=0 expected_count=0 secret_name=""
    local actual_secrets="" expected_secrets="" actual_tmpfs="" expected_tmpfs=""
    local expected_mountpoint="" host_mounts="" host_mount_count=0 expected_host_mount_count=0
    local read_only="" volume_options="" no_copy="" volume_subpath="" volume_label_count=""
    local driver_config="" bind_options="" tmpfs_options="" cluster_options="" image_options=""
    local actual_binds="" expected_binds="" bind_name=""
    mounts="$("${docker_command[@]}" inspect --format \
        '{{range .Mounts}}{{printf "%s|%s|%s|%s|%t|%s|%s\n" .Type .Name .Source .Destination .RW .Propagation .Mode}}{{end}}' \
        "$container_id")" || die "could not inspect ${service} mounts."
    while IFS='|' read -r mount_type mount_name source destination rw propagation mount_mode; do
        [[ -n "$mount_type$mount_name$source$destination$rw$propagation$mount_mode" ]] || continue
        mount_count=$((mount_count + 1))
        (( mount_count <= 64 )) || die "Compose service ${service} has too many mounts."
        [[ "$mount_name" != *[[:cntrl:]]* && "$source" != *[[:cntrl:]]* && "$destination" == /* \
            && "$destination" != *[[:cntrl:]]* && "$rw" =~ ^(true|false)$ ]] \
            || die "Compose service ${service} has a malformed mount record."
        case "$mount_type" in
            bind)
                [[ -z "$mount_name" && "$propagation" == rprivate && "$mount_mode" == ro ]] \
                    || die "Compose service ${service} bind propagation or mode drifted."
                case "${source}|${destination}|${service}|${rw}" in
                    "${root_dir}/deploy/rabbitmq/volume-init.sh|/usr/local/bin/backupsheep-rabbitmq-volume-init|rabbitmq-volume-init|false"|\
                    "${root_dir}/deploy/rabbitmq/volume-init.sh|/usr/local/bin/backupsheep-rabbitmq-volume-init|rabbitmq|false"|\
                    "${root_dir}/deploy/rabbitmq/90-backupsheep.conf|/etc/rabbitmq/conf.d/90-backupsheep.conf|rabbitmq|false"|\
                    "${root_dir}/deploy/rabbitmq/entrypoint.sh|/usr/local/bin/backupsheep-rabbitmq-entrypoint|rabbitmq|false"|\
                    "${root_dir}/deploy/rabbitmq/provision.sh|/usr/local/bin/backupsheep-rabbitmq-provision|rabbitmq-provision|false")
                        validate_private_file "$source" "${service} reviewed bind source"
                        ;;
                    "${root_dir}/.secrets/"*"|/run/secrets/"*"|${service}|false")
                        secret_name="${source#${root_dir}/.secrets/}"
                        [[ "$secret_name" != */* && -n "$secret_name" \
                            && "$destination" == "/run/secrets/${secret_name}" ]] \
                            || die "Compose service ${service} has a mismatched secret bind mount."
                        case "$secret_name" in
                            django_secret_key|db_*_password|rabbitmq_*_password|celery_signing_*_private_key|celery_trusted_public_keys|onboarding_token|ssh_managed_*_private_key|artifact_local_file_*_keyring) ;;
                            *) die "Compose service ${service} mounts an unreviewed secret source." ;;
                        esac
                        validate_private_file "$source" "${service} secret bind source"
                        actual_secrets+="${secret_name}"$'\n'
                        ;;
                    *) die "Compose service ${service} has an unreviewed or writable host bind mount." ;;
                esac
                ;;
            volume)
                [[ "$mount_name" =~ ^[a-z0-9][a-z0-9_.-]{0,127}$ && -z "$propagation" ]] \
                    || die "Compose service ${service} volume propagation drifted."
                logical="$(printf '%s\n' "$volume_map" | awk -F'|' -v physical="$mount_name" '$2 == physical { if (found++) exit 9; value=$1 } END { if (found == 1) print value; else exit 8 }')" \
                    || die "Compose service ${service} mounts a volume outside the exact reviewed model."
                expected_mountpoint="$(printf '%s\n' "$volume_mountpoint_map" | awk -F'|' -v physical="$mount_name" '$1 == physical { if (found++) exit 9; value=$2 } END { if (found == 1) print value; else exit 8 }')" \
                    || die "Compose service ${service} volume mountpoint is not bound to an inspected owned volume."
                [[ "$source" == "$expected_mountpoint" ]] \
                    || die "Compose service ${service} volume source differs from the exact inspected Docker mountpoint."
                case "${service}|${logical}|${destination}" in
                    db\|postgres_data_v1\|/var/lib/postgresql|\
                    rabbitmq-volume-init\|rabbitmq_data\|/var/lib/rabbitmq|\
                    rabbitmq\|rabbitmq_data\|/var/lib/rabbitmq|\
                    rabbitmq-provision\|rabbitmq_data\|/var/lib/rabbitmq|\
                    staging-provision\|database_workdir\|/volumes/database|\
                    staging-provision\|files_workdir\|/volumes/files|\
                    staging-provision\|storage_workdir\|/volumes/storage|\
                    staging-provision\|database_ciphertext_transfer\|/volumes/database-transfer|\
                    staging-provision\|files_ciphertext_transfer\|/volumes/files-transfer|\
                    staging-provision\|restore_ciphertext_transfer\|/volumes/restore-transfer|\
                    staging-provision\|backup_storage\|/volumes/backup-storage|\
                    staging-provision\|backup_workdir\|/volumes/legacy|\
                    staging-provision\|staging_layout_witness\|/volumes/witness|\
                    app\|installation_identity\|/run/backupsheep-installation|\
                    worker-database\|database_workdir\|/code/_storage|\
                    worker-database\|database_ciphertext_transfer\|/var/lib/backupsheep/transfer/database|\
                    worker-database\|restore_ciphertext_transfer\|/var/lib/backupsheep/restore-transfer|\
                    worker-files\|files_workdir\|/code/_storage|\
                    worker-files\|files_ciphertext_transfer\|/var/lib/backupsheep/transfer/files|\
                    worker-files\|restore_ciphertext_transfer\|/var/lib/backupsheep/restore-transfer|\
                    worker-storage\|storage_workdir\|/code/_storage|\
                    worker-storage\|database_ciphertext_transfer\|/var/lib/backupsheep/transfer/database|\
                    worker-storage\|files_ciphertext_transfer\|/var/lib/backupsheep/transfer/files|\
                    worker-storage\|restore_ciphertext_transfer\|/var/lib/backupsheep/restore-transfer|\
                    worker-storage\|backup_storage\|/backups) ;;
                    *) die "Compose service ${service} has an unreviewed volume source or target." ;;
                esac
                expected_rw=true
                case "${service}|${logical}" in
                    rabbitmq-provision\|rabbitmq_data|app\|installation_identity|\
                    worker-database\|restore_ciphertext_transfer|worker-files\|restore_ciphertext_transfer|\
                    worker-storage\|database_ciphertext_transfer|worker-storage\|files_ciphertext_transfer)
                        expected_rw=false ;;
                esac
                [[ "$rw" == "$expected_rw" ]] \
                    || die "Compose service ${service} volume read/write policy drifted."
                [[ -z "$mount_mode" ]] \
                    || die "Compose service ${service} volume mode drifted."
                ;;
            tmpfs)
                [[ -z "$mount_name" && -z "$source" && "$rw" == true && -z "$propagation" ]] \
                    || die "Compose service ${service} has a read-only, propagated, or malformed tmpfs."
                case "$destination" in
                    /tmp|/run/backupsheep|/run/backupsheep-egress|/var/run/postgresql|/var/log/rabbitmq|/run/backupsheep-rabbitmq) ;;
                    *) die "Compose service ${service} has an unreviewed tmpfs target." ;;
                esac
                ;;
            *) die "Compose service ${service} uses an unsupported mount type." ;;
        esac
    done <<< "$mounts"
    case "$service" in
        db) expected_count=4 ;;
        rabbitmq-volume-init) expected_count=3 ;;
        rabbitmq) expected_count=8 ;;
        rabbitmq-provision) expected_count=12 ;;
        staging-provision) expected_count=10 ;;
        db-provision|db-seal) expected_count=12 ;;
        migrate) expected_count=5 ;;
        preflight) expected_count=6 ;;
        *-egress-guard) expected_count=1 ;;
        app) expected_count=9 ;;
        worker-cloud|worker-logs|beat) expected_count=7 ;;
        worker-database|worker-files|worker-storage) expected_count=12 ;;
    esac
    [[ "$mount_count" == "$expected_count" ]] \
        || die "Compose service ${service} mount set is incomplete or has extra entries."

    actual_secrets="$(printf '%s' "$actual_secrets" | LC_ALL=C sort)"
    case "$service" in
        db) expected_secrets=db_bootstrap_password ;;
        rabbitmq) expected_secrets=rabbitmq_bootstrap_password ;;
        rabbitmq-provision) expected_secrets=$'rabbitmq_app_password\nrabbitmq_beat_password\nrabbitmq_bootstrap_password\nrabbitmq_cloud_password\nrabbitmq_database_password\nrabbitmq_files_password\nrabbitmq_logs_password\nrabbitmq_preflight_password\nrabbitmq_storage_password' ;;
        db-provision|db-seal) expected_secrets=$'db_app_password\ndb_beat_password\ndb_bootstrap_password\ndb_cloud_password\ndb_database_password\ndb_files_password\ndb_logs_password\ndb_migrator_password\ndb_preflight_password\ndb_storage_password' ;;
        migrate) expected_secrets=$'db_migrator_password\ndjango_secret_key\nrabbitmq_preflight_password' ;;
        preflight) expected_secrets=$'celery_trusted_public_keys\ndb_preflight_password\ndjango_secret_key\nrabbitmq_preflight_password' ;;
        app) expected_secrets=$'celery_signing_app_private_key\ncelery_trusted_public_keys\ndb_app_password\ndjango_secret_key\nonboarding_token\nrabbitmq_app_password' ;;
        worker-cloud) expected_secrets=$'celery_signing_cloud_private_key\ncelery_trusted_public_keys\ndb_cloud_password\ndjango_secret_key\nrabbitmq_cloud_password' ;;
        worker-database) expected_secrets=$'artifact_local_file_database_keyring\ncelery_signing_database_private_key\ncelery_trusted_public_keys\ndb_database_password\ndjango_secret_key\nrabbitmq_database_password\nssh_managed_database_private_key' ;;
        worker-files) expected_secrets=$'artifact_local_file_files_keyring\ncelery_signing_files_private_key\ncelery_trusted_public_keys\ndb_files_password\ndjango_secret_key\nrabbitmq_files_password\nssh_managed_files_private_key' ;;
        worker-storage) expected_secrets=$'celery_signing_storage_private_key\ncelery_trusted_public_keys\ndb_storage_password\ndjango_secret_key\nrabbitmq_storage_password' ;;
        worker-logs) expected_secrets=$'celery_signing_logs_private_key\ncelery_trusted_public_keys\ndb_logs_password\ndjango_secret_key\nrabbitmq_logs_password' ;;
        beat) expected_secrets=$'celery_signing_beat_private_key\ncelery_trusted_public_keys\ndb_beat_password\ndjango_secret_key\nrabbitmq_beat_password' ;;
        *) expected_secrets="" ;;
    esac
    [[ "$actual_secrets" == "$expected_secrets" ]] \
        || die "Compose service ${service} does not mount its exact reviewed secret set."

    while IFS= read -r bind_name; do
        [[ -n "$bind_name" ]] || continue
        expected_binds+="${root_dir}/.secrets/${bind_name}:/run/secrets/${bind_name}:ro"$'\n'
    done <<< "$expected_secrets"
    case "$service" in
