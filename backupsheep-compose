        db\|app-database|db\|migrate-database|db\|cloud-database|db\|database-database|\
        db\|files-database|db\|storage-database|db\|logs-database|db\|beat-database|\
        db\|preflight-database|db\|provision-database|\
        rabbitmq\|app-broker|rabbitmq\|cloud-broker|rabbitmq\|database-broker|\
        rabbitmq\|files-broker|rabbitmq\|storage-broker|rabbitmq\|logs-broker|\
        rabbitmq\|beat-broker|rabbitmq\|preflight-broker|rabbitmq\|provision-broker|\
        rabbitmq-provision\|provision-broker|db-provision\|provision-database|\
        db-seal\|provision-database|migrate\|migrate-database|\
        preflight\|preflight-database|preflight\|preflight-broker|\
        app-egress-guard\|app-database|app-egress-guard\|app-broker|app-egress-guard\|app-egress|\
        cloud-egress-guard\|cloud-database|cloud-egress-guard\|cloud-broker|cloud-egress-guard\|cloud-egress|\
        database-egress-guard\|database-database|database-egress-guard\|database-broker|database-egress-guard\|database-egress|\
        files-egress-guard\|files-database|files-egress-guard\|files-broker|files-egress-guard\|files-egress|\
        storage-egress-guard\|storage-database|storage-egress-guard\|storage-broker|storage-egress-guard\|storage-egress|\
        logs-egress-guard\|logs-database|logs-egress-guard\|logs-broker|logs-egress-guard\|logs-egress|\
