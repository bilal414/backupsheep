attest_current_egress_guard_for_run() {
    local workload_service="$1"
    local guard_service=""
    local expected_image_listing=""
    local expected_image_ref=""
    local expected_image_id=""
    local container_listing=""
    local container_id=""
    local candidate_service=""
    local guard_container_id=""
    local guard_count=0
    local container_image_ref=""
    local container_image_id=""
    local container_state=""
    local container_health=""
    local restart_policy=""

    case "$workload_service" in
        app) guard_service=app-egress-guard ;;
        worker-cloud) guard_service=cloud-egress-guard ;;
        worker-database) guard_service=database-egress-guard ;;
        worker-files) guard_service=files-egress-guard ;;
        worker-storage) guard_service=storage-egress-guard ;;
        worker-logs) guard_service=logs-egress-guard ;;
        *) die "internal egress-backed run service inventory is invalid." ;;
    esac

    expected_image_listing="$(
        "${compose_command[@]}" --profile operations config --images "$guard_service"
    )" || die "could not resolve the current ${guard_service} image."
    expected_image_ref="$(single_reviewed_service_image "$expected_image_listing")" \
        || die "${guard_service} must resolve to exactly one reviewed local image reference."
    expected_image_id="$(
        "${docker_command[@]}" image inspect --format '{{.Id}}' "$expected_image_ref"
    )" || die "the current ${guard_service} image is not present for attestation."
    [[ "$expected_image_id" =~ ^sha256:[0-9a-f]{64}$ ]] \
        || die "the current ${guard_service} image returned a malformed local image ID."

    container_listing="$(
        "${docker_command[@]}" ps --all --quiet \
            --filter "label=com.docker.compose.project=${project_name}"
    )" || die "could not inventory the current ${guard_service} container."
    while IFS= read -r container_id; do
        [[ -n "$container_id" ]] || continue
        candidate_service="$(docker_resource_label \
            container "$container_id" com.docker.compose.service)" \
            || die "could not inspect an egress guard service label."
        [[ "$candidate_service" == "$guard_service" ]] || continue
        guard_count=$((guard_count + 1))
        guard_container_id="$container_id"
    done <<< "$container_listing"
    (( guard_count == 1 )) \
        || die "an egress-backed run requires exactly one existing ${guard_service} container."

    container_image_ref="$(
        "${docker_command[@]}" inspect --format '{{.Config.Image}}' "$guard_container_id"
    )" || die "could not inspect the current ${guard_service} image reference."
    container_image_id="$(
        "${docker_command[@]}" inspect --format '{{.Image}}' "$guard_container_id"
    )" || die "could not inspect the current ${guard_service} image ID."
    container_state="$(
        "${docker_command[@]}" inspect --format '{{.State.Status}}' "$guard_container_id"
    )" || die "could not inspect the current ${guard_service} state."
    container_health="$(
        "${docker_command[@]}" inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$guard_container_id"
    )" || die "could not inspect the current ${guard_service} health."
    restart_policy="$(
        "${docker_command[@]}" inspect --format '{{.HostConfig.RestartPolicy.Name}}' "$guard_container_id"
    )" || die "could not inspect the current ${guard_service} restart policy."
    [[ "$container_image_ref" == "$expected_image_ref" \
        && "$container_image_id" == "$expected_image_id" ]] \
        || die "${guard_service} is not running the exact current local egress image."
    [[ "$container_state" == "running" && "$container_health" == "healthy" ]] \
        || die "${guard_service} must already be running and healthy; recreate its exact pair first."
    [[ "$restart_policy" == "no" ]] \
        || die "${guard_service} does not have the required no-restart lifecycle."
    "${docker_command[@]}" exec "$guard_container_id" \
        /usr/local/bin/backupsheep-egress-healthcheck >/dev/null 2>&1 \
        || die "${guard_service} failed its fresh kernel-lease healthcheck."
}

refuse_existing_egress_oneoffs() {
    local container_listing=""
    local container_id=""
    local oneoff_label=""
    local service_name=""

    container_listing="$(
        "${docker_command[@]}" ps --all --quiet \
            --filter "label=com.docker.compose.project=${project_name}"
    )" || die "could not inventory Compose one-off containers before changing an egress lifecycle."
    while IFS= read -r container_id; do
        [[ -n "$container_id" ]] || continue
        oneoff_label="$(docker_resource_label \
            container "$container_id" com.docker.compose.oneoff)" \
            || die "could not inspect a Compose one-off lifecycle label."
        case "$oneoff_label" in
            True|true|TRUE|1) ;;
            *) continue ;;
        esac
        service_name="$(docker_resource_label \
            container "$container_id" com.docker.compose.service)" \
            || die "could not inspect a Compose one-off service label."
        case "$service_name" in
            app|worker-cloud|worker-database|worker-files|worker-storage|worker-logs)
                die "an egress-backed Compose one-off for ${service_name} still exists. Inspect, stop, and remove that exact one-off before running another one-off, removing the stack, or recreating its guard/workload pair."
                ;;
        esac
    done <<< "$container_listing"
}

validate_enabled_rabbitmq_feature_flags() {
    local rabbit_container_id="$1"
    local policy="$2"
    local expected_khepri_state="$3"
    local phase="$4"
    local feature_flags=""

    feature_flags="$(
        "${docker_command[@]}" exec --user rabbitmq "$rabbit_container_id" \
            rabbitmqctl -q list_feature_flags name stability state 2>/dev/null
    )" || die "could not query RabbitMQ feature flags during ${phase}."
    printf '%s\n' "$feature_flags" | awk \
        -v policy="$policy" -v expected_khepri_state="$expected_khepri_state" '
        $1 == "name" && $2 == "stability" && $3 == "state" { next }
        NF != 3 || seen[$1]++ { exit 41 }
        {
            row_count++
        }
        $2 == "required" || (policy == "all" && $2 == "stable") {
            gated_count++
            if ($3 != "enabled") exit 42
        }
        $1 == "khepri_db" {
            khepri_count++
            khepri_state = $3
        }
        END {
            if (row_count == 0 || (policy == "all" && gated_count == 0)) exit 43
            if (expected_khepri_state != "none" &&
                (khepri_count != 1 || khepri_state != expected_khepri_state)) exit 44
        }
    ' || die "RabbitMQ feature flags are ambiguous or a stable/required flag is not enabled during ${phase}."
}

validate_rabbitmq_data_generation() {
    local resource_id=""
    local logical_name=""
    local rabbit_container_id=""
    local rabbit_volume_id=""
    local container_listing=""
    local volume_listing=""
    local container_state=""
    local container_health=""
    local server_version=""
