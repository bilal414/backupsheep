}

validate_network_runtime_policy() {
    local resource_id="$1" logical_name="$2" state="" expected_internal="true" expected_option_count="0"
    local expected_icc="" ipam="" ipam_count="" subnet="" ip_range="" gateway="" aux_count="" remainder=""
    local endpoints="" endpoint_container="" endpoint_name="" endpoint_id="" endpoint_mac=""
    local endpoint_ipv4="" endpoint_ipv6="" endpoint_count=0 endpoint_project="" endpoint_installation=""
    local endpoint_service="" endpoint_working_dir="" physical_name="" network_id="" endpoint_state=""
    local container_name="" aliases="" expected_aliases="" links="" container_network_id=""
    local container_endpoint_id="" container_gateway="" container_ip="" container_prefix="" container_mac=""
    local actual_endpoint_ids="" expected_endpoint_ids="" existing_container="" existing_service="" existing_full_id=""
    case "$logical_name" in
        app-egress|cloud-egress|database-egress|files-egress|storage-egress|logs-egress)
            expected_internal="false"
            expected_option_count="1"
            expected_icc="false"
            ;;
    esac
    state="$("${docker_command[@]}" network inspect --format \
        '{{.Driver}}|{{.Internal}}|{{.Attachable}}|{{.Ingress}}|{{len .Options}}|{{index .Options "com.docker.network.bridge.enable_icc"}}|{{.IPAM.Driver}}|{{len .IPAM.Options}}' \
        "$resource_id")" || die "could not inspect Docker network runtime policy."
    [[ "$state" == "bridge|${expected_internal}|false|false|${expected_option_count}|${expected_icc}|default|0" ]] \
        || die "Docker network ${logical_name} has an unsafe driver, namespace, attachment, option, or IPAM policy."
    ipam="$("${docker_command[@]}" network inspect --format \
        '{{len .IPAM.Config}}|{{range .IPAM.Config}}{{.Subnet}}|{{.IPRange}}|{{.Gateway}}|{{len .AuxiliaryAddresses}}{{end}}' \
        "$resource_id")" || die "could not inspect Docker network IPAM configuration."
    IFS='|' read -r ipam_count subnet ip_range gateway aux_count remainder <<< "$ipam"
    [[ "$ipam_count" == 1 && -z "$ip_range" && "$aux_count" == 0 && -z "$remainder" \
        && "$subnet" =~ ^[0-9A-Fa-f:.]+/[0-9]{1,3}$ \
        && "$gateway" =~ ^[0-9A-Fa-f:.]+$ && "$gateway" != 0.0.0.0 && "$gateway" != :: ]] \
        || die "Docker network ${logical_name} has an unsafe or ambiguous IPAM allocation."

    physical_name="$(docker_resource_name network "$resource_id")" \
        || die "could not inspect Docker network physical name."
    network_id="$("${docker_command[@]}" network inspect --format '{{.Id}}' "$resource_id")" \
        || die "could not inspect Docker network ID."
    [[ "$physical_name" == "${project_name}_${logical_name}" \
        && "$network_id" =~ ^[0-9a-f]{64}$ ]] \
        || die "Docker network ${logical_name} has a malformed physical identity."
    endpoints="$("${docker_command[@]}" network inspect --format \
        '{{range $id, $endpoint := .Containers}}{{printf "%s|%s|%s|%s|%s|%s\n" $id $endpoint.Name $endpoint.EndpointID $endpoint.MacAddress $endpoint.IPv4Address $endpoint.IPv6Address}}{{end}}' \
        "$resource_id")" || die "could not inspect Docker network endpoint membership."
    while IFS='|' read -r endpoint_container endpoint_name endpoint_id endpoint_mac endpoint_ipv4 endpoint_ipv6; do
        [[ -n "$endpoint_container$endpoint_name$endpoint_id$endpoint_mac$endpoint_ipv4$endpoint_ipv6" ]] || continue
        endpoint_count=$((endpoint_count + 1)); (( endpoint_count <= 256 )) \
            || die "Docker network ${logical_name} has too many endpoints."
        [[ "$endpoint_container" =~ ^[0-9a-f]{64}$ && "$endpoint_id" =~ ^[0-9a-f]{64}$ \
            && "$endpoint_name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ \
            && "$endpoint_mac" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ \
            && "$endpoint_ipv4" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/[0-9]{1,2}$ \
            && -z "$endpoint_ipv6" ]] \
            || die "Docker network ${logical_name} has a malformed endpoint record."
        endpoint_project="$(docker_resource_label container "$endpoint_container" com.docker.compose.project)" \
            || die "Docker network ${logical_name} contains an unattested endpoint."
        endpoint_installation="$(docker_resource_label container "$endpoint_container" com.backupsheep.installation-id)" \
            || die "Docker network ${logical_name} contains an unattested endpoint identity."
        endpoint_service="$(docker_resource_label container "$endpoint_container" com.docker.compose.service)" \
            || die "Docker network ${logical_name} contains an unattested endpoint service."
        endpoint_working_dir="$(docker_resource_label container "$endpoint_container" com.docker.compose.project.working_dir)" \
            || die "Docker network ${logical_name} contains an unattested endpoint source."
        [[ "$endpoint_project" == "$project_name" && "$endpoint_installation" == "$installation_id" \
            && "$endpoint_working_dir" == "$root_dir" ]] \
            || die "Docker network ${logical_name} contains a foreign or wrong-installation endpoint."
        service_network_is_authorized "$endpoint_service" "$logical_name" \
            || die "Docker network ${logical_name} contains a service outside its reviewed topology."
        container_name="$("${docker_command[@]}" inspect --format '{{.Name}}' "$endpoint_container")" \
            || die "could not inspect Docker network endpoint container name."
        container_name="${container_name#/}"
        [[ "$container_name" == "$endpoint_name" ]] \
            || die "Docker network ${logical_name} endpoint name disagrees with its container."
        endpoint_state="$("${docker_command[@]}" inspect --format \
            "{{with index .NetworkSettings.Networks \"${physical_name}\"}}{{.NetworkID}}|{{.EndpointID}}|{{.Gateway}}|{{.IPAddress}}|{{.IPPrefixLen}}|{{.MacAddress}}|{{len .Links}}{{else}}||||||-1{{end}}" \
            "$endpoint_container")" || die "could not inspect container-side Docker network endpoint."
        IFS='|' read -r container_network_id container_endpoint_id container_gateway container_ip container_prefix container_mac links <<< "$endpoint_state"
        [[ "$container_network_id" == "$network_id" && "$container_endpoint_id" == "$endpoint_id" \
            && "${container_ip}/${container_prefix}" == "$endpoint_ipv4" \
            && "$container_gateway" == "$gateway" && "$container_mac" == "$endpoint_mac" \
            && "$links" == 0 ]] \
            || die "Docker network ${logical_name} endpoint state disagrees across Engine views."
        aliases="$("${docker_command[@]}" inspect --format \
            "{{with index .NetworkSettings.Networks \"${physical_name}\"}}{{range .Aliases}}{{println .}}{{end}}{{end}}" \
            "$endpoint_container" | LC_ALL=C sort)" || die "could not inspect Docker network endpoint aliases."
        expected_aliases="$(printf '%s\n%s\n' "$container_name" "$endpoint_service" | LC_ALL=C sort -u)"
        [[ "$aliases" == "$expected_aliases" ]] \
            || die "Docker network ${logical_name} endpoint aliases drifted from the reviewed topology."
        actual_endpoint_ids+="${endpoint_container}"$'\n'
    done <<< "$endpoints"
    # Prove both directions of membership. Merely validating the endpoints that
    # Docker reports would miss a detached expected container; merely validating
    # each container's network list would miss a foreign endpoint. The project
    # inventory is dynamically scoped from validate_compose_project_ownership.
    for existing_container in "${container_ids[@]}"; do
        existing_service="$(docker_resource_label container "$existing_container" com.docker.compose.service)" \
            || die "could not inspect existing container service while validating network membership."
        service_network_is_authorized "$existing_service" "$logical_name" || continue
        existing_full_id="$("${docker_command[@]}" inspect --format '{{.Id}}' "$existing_container")" \
            || die "could not inspect existing container ID while validating network membership."
        [[ "$existing_full_id" =~ ^[0-9a-f]{64}$ ]] \
            || die "existing container has a malformed full ID during network validation."
        expected_endpoint_ids+="${existing_full_id}"$'\n'
    done
    actual_endpoint_ids="$(printf '%s' "$actual_endpoint_ids" | LC_ALL=C sort)"
    expected_endpoint_ids="$(printf '%s' "$expected_endpoint_ids" | LC_ALL=C sort)"
    [[ "$actual_endpoint_ids" == "$expected_endpoint_ids" ]] \
        || die "Docker network ${logical_name} complete endpoint set differs from the reviewed existing-container topology."
}

validate_volume_runtime_policy() {
    local resource_id="$1" logical_name="$2" physical_name="$3" state="" driver="" options="" scope="" mountpoint=""
    state="$("${docker_command[@]}" volume inspect --format \
        '{{.Driver}}|{{len .Options}}|{{.Scope}}|{{.Mountpoint}}' "$resource_id")" \
        || die "could not inspect Docker volume runtime policy."
    IFS='|' read -r driver options scope mountpoint <<< "$state"
    [[ "$driver" == "local" && "$options" == "0" && "$scope" == "local" \
        && "$mountpoint" == /*/volumes/"${physical_name}"/_data \
        && "$mountpoint" != *[[:cntrl:]]* ]] \
        || die "Docker volume ${logical_name} has an unsafe driver, bind option, scope, or mountpoint."
    if printf '%s' "${volume_mountpoint_map-}" | grep -Fxq -- "${physical_name}|${mountpoint}"; then
        return
    fi
    ! printf '%s' "${volume_mountpoint_map-}" | awk -F'|' -v physical="$physical_name" \
        '$1 == physical { found=1 } END { exit(found ? 0 : 1) }' \
        || die "Docker volume ${logical_name} returned conflicting physical mountpoint witnesses."
    volume_mountpoint_map+="${physical_name}|${mountpoint}"$'\n'
}

parse_rendered_resource_map() {
    local section="$1"
    local rendered_model="$2"

    # Compose's canonical YAML is generated by the Docker CLI, not read from an
    # operator-authored file. Accept only its simple top-level resource shape and
    # fail closed if a future Compose release changes that contract.
    printf '%s\n' "$rendered_model" | awk -v wanted="$section" '
        BEGIN { external = "false" }
        function emit_resource() {
            if (logical == "") return
            if (physical == "" || external == "true") invalid = 1
            if (logical !~ /^[A-Za-z0-9_.-]+$/ || physical !~ /^[A-Za-z0-9_.-]+$/) invalid = 1
            print logical "|" physical "|" external
            logical = ""
            physical = ""
            external = "false"
            seen++
        }
        $0 == wanted ":" {
            in_section = 1
            next
        }
        in_section && $0 ~ /^[^[:space:]]/ {
            emit_resource()
            in_section = 0
        }
        in_section && $0 ~ /^  [A-Za-z0-9_.-]+:$/ {
            emit_resource()
            logical = $0
            sub(/^  /, "", logical)
            sub(/:$/, "", logical)
            next
        }
        in_section && logical != "" && $0 ~ /^    name:[[:space:]]*/ {
            physical = $0
            sub(/^    name:[[:space:]]*/, "", physical)
            if (physical ~ /^".*"$/) {
                sub(/^"/, "", physical)
                sub(/"$/, "", physical)
            }
            next
        }
        in_section && logical != "" && $0 == "    external: true" {
            external = "true"
            next
        }
        END {
            emit_resource()
            if (!seen || invalid) exit 41
        }
    '
}

validate_compose_project_ownership() {
    local require_existing_sentinel="${1:-false}"
    local resource_id=""
    local resource_name=""
    local resource_installation_id=""
    local working_dir=""
    local config_files=""
    local base_config_files=""
    local rabbit_config_files=""
    local logical_name=""
    local physical_name=""
    local external_resource=""
    local available_services=""
    local available_networks=""
    local available_volumes=""
    local rendered_model=""
    local rendered_model_json=""
    local network_map=""
    local volume_map=""
    local volume_mountpoint_map=""
    local all_network_names=""
    local all_volume_names=""
    local retired_ssh_trust_name="${project_name}_ssh_trust"
    local retired_ssh_trust_attachments=""
    local retired_pgdata_name="${project_name}_pgdata"
    local retired_pgdata_attachments=""
    local resource_project=""
    local is_retired_ssh_trust=false
    local is_retired_pgdata=false
    local container_count=0
    local network_count=0
    local volume_count=0
    local identity_volume_count=0
    local legacy_container_identity_count=0
    local container_service_inventory=""
    local duplicate_service=""
    local oneoff_label=""
    local container_listing=""
    local network_listing=""
    local volume_listing=""
    local -a container_ids=()
    local -a network_ids=()
    local -a volume_ids=()

    rendered_model="$("${compose_command[@]}" --profile operations config)" \
        || die "could not render the reviewed Compose model."
    rendered_model_json="$("${compose_command[@]}" --profile operations config --format json)" \
        || die "could not render the reviewed Compose JSON model."
    [[ -n "$rendered_model_json" && ${#rendered_model_json} -le 2097151 ]] \
        || die "reviewed Compose JSON model is empty or exceeds the bounded parser limit."
    network_map="$(parse_rendered_resource_map networks "$rendered_model")" \
        || die "could not prove canonical non-external Compose network names."
    volume_map="$(parse_rendered_resource_map volumes "$rendered_model")" \
        || die "could not prove canonical non-external Compose volume names."
    available_networks="$(awk -F'|' '{ print $1 }' <<< "$network_map")"
    available_volumes="$(awk -F'|' '{ print $1 }' <<< "$volume_map")"

    while IFS='|' read -r logical_name physical_name external_resource; do
        [[ "$external_resource" == "false" && "$physical_name" == "${project_name}_${logical_name}" ]] \
            || die "network ${logical_name} must use its canonical project-owned name and cannot be external."
    done <<< "$network_map"
    while IFS='|' read -r logical_name physical_name external_resource; do
        [[ "$external_resource" == "false" && "$physical_name" == "${project_name}_${logical_name}" ]] \
            || die "volume ${logical_name} must use its canonical project-owned name and cannot be external."
    done <<< "$volume_map"

    container_listing="$(
        "${docker_command[@]}" ps --all --quiet \
            --filter "label=com.docker.compose.project=${project_name}"
    )" || die "could not inventory existing Compose containers; refusing command."
    network_listing="$(
        "${docker_command[@]}" network ls --quiet \
            --filter "label=com.docker.compose.project=${project_name}"
    )" || die "could not inventory existing Compose networks; refusing command."
    volume_listing="$(
        "${docker_command[@]}" volume ls --quiet \
            --filter "label=com.docker.compose.project=${project_name}"
    )" || die "could not inventory existing Compose volumes; refusing command."
    all_network_names="$("${docker_command[@]}" network ls --format '{{.Name}}')" \
        || die "could not inventory Docker network names; refusing command."
    all_volume_names="$("${docker_command[@]}" volume ls --format '{{.Name}}')" \
        || die "could not inventory Docker volume names; refusing command."

    while IFS= read -r resource_id; do
        if [[ -n "$resource_id" ]]; then
            container_ids+=("$resource_id")
            container_count=$((container_count + 1))
        fi
    done <<< "$container_listing"
    while IFS= read -r resource_id; do
        if [[ -n "$resource_id" ]]; then
            network_ids+=("$resource_id")
            network_count=$((network_count + 1))
        fi
    done <<< "$network_listing"
    while IFS= read -r resource_id; do
        if [[ -n "$resource_id" ]]; then
            volume_ids+=("$resource_id")
            volume_count=$((volume_count + 1))
        fi
    done <<< "$volume_listing"

    base_config_files="$base_file"
    if [[ "$approved_default" == true ]]; then
        base_config_files+=",${default_override}"
    fi
    if [[ "$image_mode" == "signed-release" ]]; then
        rabbit_config_files="${base_config_files},${rabbitmq_upgrade},${release_overlay}"
        base_config_files+=",${release_overlay}"
    else
        rabbit_config_files="${base_config_files},${rabbitmq_upgrade}"
    fi

    # Compose can adopt an exact-name pre-existing resource after only a warning.
    # Prove every physical name, including unlabeled collisions omitted from the
    # project-filtered inventory.
    while IFS='|' read -r logical_name physical_name external_resource; do
        grep -Fxq -- "$physical_name" <<< "$all_network_names" || continue
        resource_project="$(docker_resource_label network "$physical_name" com.docker.compose.project)" \
            || die "could not inspect Docker network ${physical_name}."
        resource_installation_id="$(docker_resource_label network "$physical_name" com.docker.compose.network)" \
            || die "could not inspect Docker network ${physical_name}."
        [[ "$resource_project" == "$project_name" && "$resource_installation_id" == "$logical_name" ]] \
            || die "Docker network ${physical_name} collides with this model but is not owned by it."
        validate_network_runtime_policy "$physical_name" "$logical_name"
    done <<< "$network_map"
    while IFS='|' read -r logical_name physical_name external_resource; do
        grep -Fxq -- "$physical_name" <<< "$all_volume_names" || continue
        resource_project="$(docker_resource_label volume "$physical_name" com.docker.compose.project)" \
            || die "could not inspect Docker volume ${physical_name}."
        resource_installation_id="$(docker_resource_label volume "$physical_name" com.docker.compose.volume)" \
            || die "could not inspect Docker volume ${physical_name}."
        [[ "$resource_project" == "$project_name" && "$resource_installation_id" == "$logical_name" ]] \
            || die "Docker volume ${physical_name} collides with this model but is not owned by it."
        validate_volume_runtime_policy "$physical_name" "$logical_name" "$physical_name"
    done <<< "$volume_map"
    # ssh_trust is deliberately absent from the current model. Inspect its old
    # canonical physical name separately so an unlabeled/foreign collision can
    # never pass as inert rollback evidence.
    if grep -Fxq -- "$retired_ssh_trust_name" <<< "$all_volume_names"; then
        resource_project="$(docker_resource_label volume "$retired_ssh_trust_name" com.docker.compose.project)" \
            || die "could not inspect retired Docker volume ${retired_ssh_trust_name}."
        logical_name="$(docker_resource_label volume "$retired_ssh_trust_name" com.docker.compose.volume)" \
            || die "could not inspect retired Docker volume ${retired_ssh_trust_name}."
        [[ "$resource_project" == "$project_name" && "$logical_name" == "ssh_trust" ]] \
            || die "Docker volume ${retired_ssh_trust_name} collides with the retired BackupSheep trust volume but is not owned by it."
    fi
    if grep -Fxq -- "$retired_pgdata_name" <<< "$all_volume_names"; then
        resource_project="$(docker_resource_label volume "$retired_pgdata_name" com.docker.compose.project)" \
            || die "could not inspect retired Docker volume ${retired_pgdata_name}."
        logical_name="$(docker_resource_label volume "$retired_pgdata_name" com.docker.compose.volume)" \
            || die "could not inspect retired Docker volume ${retired_pgdata_name}."
        [[ "$resource_project" == "$project_name" && "$logical_name" == "pgdata" \
            && ( "$postgres_storage_intent" == "migrated-debian-v1" \
                || "$postgres_storage_intent" == "migrated-debian-generation2-v1" ) ]] \
            || die "Docker volume ${retired_pgdata_name} collides with retired PostgreSQL rollback storage but is not owned by it."
    fi

    if (( container_count == 0 && network_count == 0 && volume_count == 0 )); then
        [[ "$require_existing_sentinel" == false ]] \
            || die "volume deletion requires an existing verified installation-identity sentinel."
        if [[ "$fresh_resource_creation" == true && "$dry_run_requested" == false ]]; then
            local sentinel_name="${project_name}_installation_identity"
            local created_name=""
            created_name="$(
                "${docker_command[@]}" volume create \
                    --driver local \
                    --label "com.docker.compose.project=${project_name}" \
                    --label "com.docker.compose.volume=installation_identity" \
                    --label "com.backupsheep.installation-id=${installation_id}" \
                    "$sentinel_name"
            )" || die "could not create the fresh installation-identity sentinel."
            [[ "$created_name" == "$sentinel_name" ]] \
                || die "Docker returned an unexpected installation-identity volume name."
            resource_project="$(docker_resource_label volume "$sentinel_name" com.docker.compose.project)" \
                || die "could not re-inspect the fresh installation-identity sentinel."
            logical_name="$(docker_resource_label volume "$sentinel_name" com.docker.compose.volume)" \
                || die "could not re-inspect the fresh installation-identity sentinel."
            resource_installation_id="$(docker_resource_label volume "$sentinel_name" com.backupsheep.installation-id)" \
                || die "could not re-inspect the fresh installation-identity sentinel."
            [[ "$resource_project" == "$project_name" && \
               "$logical_name" == "installation_identity" && \
               "$resource_installation_id" == "$installation_id" ]] \
                || die "the fresh installation-identity sentinel did not retain every required label."
        fi
        return
    fi

    available_services="$("${compose_command[@]}" --profile operations config --services)" \
        || die "could not inventory services in the reviewed Compose model."

    if (( container_count > 0 )); then
        for resource_id in "${container_ids[@]}"; do
            working_dir="$(docker_resource_label container "$resource_id" com.docker.compose.project.working_dir)" \
                || die "could not inspect a Compose container working directory."
            config_files="$(docker_resource_label container "$resource_id" com.docker.compose.project.config_files)" \
                || die "could not inspect a Compose container configuration path."
            logical_name="$(docker_resource_label container "$resource_id" com.docker.compose.service)" \
                || die "could not inspect a Compose container service label."
            [[ "$working_dir" == "$root_dir" ]] \
                || die "Compose project ${project_name} has a container owned by a different installation path."
            if [[ "$logical_name" == "rabbitmq" ]]; then
                if [[ -n "$rabbitmq_transition_target" ]]; then
                    [[ "$config_files" == "$base_config_files" || "$config_files" == "$rabbit_config_files" ]] \
                        || die "the RabbitMQ transition found a container outside the two canonical migration models."
                else
                    [[ "$config_files" == "$base_config_files" ]] \
                        || die "RabbitMQ is still labeled with the compatibility overlay; complete the reviewed 4.3 transition."
                fi
            else
                [[ "$config_files" == "$base_config_files" ]] \
                    || die "Compose project ${project_name} has a container owned by a different model."
            fi
            grep -Fxq -- "$logical_name" <<< "$available_services" \
                || die "Compose project ${project_name} has an unexpected service container: ${logical_name}."
            oneoff_label="$(docker_resource_label container "$resource_id" com.docker.compose.oneoff)" \
                || die "could not inspect a Compose container one-off label."
            case "$oneoff_label" in
                ""|False|false|FALSE|0) ;;
                True|true|TRUE|1)
                    case "$logical_name" in
                        app|worker-cloud|worker-database|worker-files|worker-storage|worker-logs)
                            die "an egress-backed Compose one-off for ${logical_name} still exists; exact runtime cardinality cannot be proved."
                            ;;
                        *) die "Compose project ${project_name} has a stranded one-off container for ${logical_name}; exact runtime cardinality cannot be proved." ;;
                    esac
                    ;;
                *) die "Compose project ${project_name} has a malformed one-off lifecycle label." ;;
            esac
            container_service_inventory+="${logical_name}"$'\n'
            resource_installation_id="$(docker_resource_label container "$resource_id" com.backupsheep.installation-id)" \
                || die "could not inspect a Compose container installation identity."
            if [[ -z "$resource_installation_id" ]]; then
                legacy_container_identity_count=$((legacy_container_identity_count + 1))
            else
                [[ "$resource_installation_id" == "$installation_id" ]] \
                    || die "Compose project ${project_name} has a container with a different BackupSheep installation identity."
            fi
            if [[ "$image_mode" == "signed-release" ]]; then
                if [[ "$logical_name" != rabbitmq || -z "$rabbitmq_transition_target" ]]; then
                    attest_signed_release_container_image "$logical_name" "$resource_id"
                fi
            fi
            validate_container_runtime_policy "$logical_name" "$resource_id"
        done
        duplicate_service="$(printf '%s' "$container_service_inventory" | awk '
            NF != 1 { exit 41 }
            { count[$1]++ }
            END {
                for (service in count) {
                    maximum = (service ~ /^worker-(cloud|database|files|storage|logs)$/) ? 32 : 1
                    if (count[service] > maximum) {
                        print service "|" count[service] "|" maximum
                        exit
                    }
                }
            }
        ')" || die "could not validate Compose service cardinality."
        [[ -z "$duplicate_service" ]] \
            || die "Compose service ${duplicate_service%%|*} exceeds its exact reviewed container cardinality (${duplicate_service#*|})."
    fi

    # The empty sentinel volume is the durable ownership witness after `down`
    # removes every container and network. Other stock volume labels are immutable
    # but may predate the installation-id label, so a blank legacy label is accepted
    # only after this sentinel is proved.
    if (( volume_count > 0 )); then
        for resource_id in "${volume_ids[@]}"; do
            logical_name="$(docker_resource_label volume "$resource_id" com.docker.compose.volume)" \
                || die "could not inspect a Compose volume logical name."
            [[ "$logical_name" == "installation_identity" ]] || continue
            resource_name="$(docker_resource_name volume "$resource_id")" \
                || die "could not inspect the Compose ownership-sentinel name."
            [[ "$resource_name" == "${project_name}_installation_identity" ]] \
                || die "the Compose ownership sentinel has a non-canonical name."
            resource_installation_id="$(docker_resource_label volume "$resource_id" com.backupsheep.installation-id)" \
                || die "could not inspect the Compose ownership sentinel."
            [[ "$resource_installation_id" == "$installation_id" ]] \
                || die "the Compose ownership sentinel belongs to a different BackupSheep installation."
            identity_volume_count=$((identity_volume_count + 1))
        done
    fi
    (( identity_volume_count == 1 )) \
        || die "existing Compose resources require exactly one matching installation-identity sentinel."

    # Container labels are immutable. The installer may encounter containers from a
    # pre-hardening stock deployment whose exact project, installation path, config
    # file and service were proved before it created this sentinel. A blank identity
    # is accepted only under that durable witness so Compose can safely recreate the
    # legacy containers (including the reviewed RabbitMQ generation hops).
    if (( legacy_container_identity_count > 0 )); then
        (( identity_volume_count == 1 )) \
            || die "legacy Compose containers require the matching installation-identity sentinel."
    fi

    if (( network_count > 0 )); then
        for resource_id in "${network_ids[@]}"; do
            logical_name="$(docker_resource_label network "$resource_id" com.docker.compose.network)" \
                || die "could not inspect a Compose network logical name."
            grep -Fxq -- "$logical_name" <<< "$available_networks" \
                || die "Compose project ${project_name} has an unexpected network: ${logical_name}."
            resource_name="$(docker_resource_name network "$resource_id")" \
                || die "could not inspect a Compose network name."
            [[ "$resource_name" == "${project_name}_${logical_name}" ]] \
                || die "Compose network ${logical_name} has a non-canonical physical name."
            validate_network_runtime_policy "$resource_id" "$logical_name"
            resource_installation_id="$(docker_resource_label network "$resource_id" com.backupsheep.installation-id)" \
                || die "could not inspect a Compose network installation identity."
            if [[ -z "$resource_installation_id" ]]; then
                : # Legacy labels are immutable; the matching sentinel proves this project.
            else
                [[ "$resource_installation_id" == "$installation_id" ]] \
                    || die "Compose network ${logical_name} belongs to a different BackupSheep installation."
            fi
        done
    fi

    if (( volume_count > 0 )); then
        for resource_id in "${volume_ids[@]}"; do
            logical_name="$(docker_resource_label volume "$resource_id" com.docker.compose.volume)" \
                || die "could not inspect a Compose volume logical name."
            is_retired_ssh_trust=false
            is_retired_pgdata=false
            if ! grep -Fxq -- "$logical_name" <<< "$available_volumes"; then
                # Preserve the exact develop-era global trust volume as detached
                # rollback evidence. No reviewed service can mount it, and this
                # wrapper rejects every host/named-volume runtime override.
                case "$logical_name" in
                    ssh_trust) is_retired_ssh_trust=true ;;
                    pgdata)
                        [[ "$postgres_storage_intent" == "migrated-debian-v1" \
                            || "$postgres_storage_intent" == "migrated-debian-generation2-v1" ]] \
                            || die "retired pgdata is valid only after the explicit PostgreSQL migration."
                        is_retired_pgdata=true
                        ;;
                    *) die "Compose project ${project_name} has an unexpected volume: ${logical_name}." ;;
                esac
                (( identity_volume_count == 1 )) \
                    || die "a retired Compose volume requires exactly one matching installation-identity sentinel."
            fi
            resource_name="$(docker_resource_name volume "$resource_id")" \
                || die "could not inspect a Compose volume name."
            [[ "$resource_name" == "${project_name}_${logical_name}" ]] \
                || die "Compose volume ${logical_name} has a non-canonical physical name."
            validate_volume_runtime_policy "$resource_id" "$logical_name" "$resource_name"
            if [[ "$is_retired_ssh_trust" == true ]]; then
                resource_project="$(docker_resource_label volume "$resource_id" com.docker.compose.project)" \
                    || die "could not inspect retired Compose volume ssh_trust."
                [[ "$resource_project" == "$project_name" ]] \
                    || die "the retired Compose volume ssh_trust is not owned by project ${project_name}."
                retired_ssh_trust_attachments="$("${docker_command[@]}" ps --all --quiet \
                    --filter "volume=${resource_name}")" \
                    || die "could not prove that retired Compose volume ssh_trust is detached."
                [[ -z "$retired_ssh_trust_attachments" ]] \
                    || die "the retired Compose volume ssh_trust still has attached containers; remove every running or stopped legacy container before retrying."
            fi
            if [[ "$is_retired_pgdata" == true ]]; then
                resource_project="$(docker_resource_label volume "$resource_id" com.docker.compose.project)" \
                    || die "could not inspect retired Compose volume pgdata."
                [[ "$resource_project" == "$project_name" ]] \
                    || die "retired Compose volume pgdata is not owned by project ${project_name}."
                retired_pgdata_attachments="$("${docker_command[@]}" ps --all --quiet \
                    --filter "volume=${resource_name}")" \
                    || die "could not prove retired Compose volume pgdata is detached."
                [[ -z "$retired_pgdata_attachments" ]] \
                    || die "retired Compose volume pgdata must remain detached from every container."
            fi
            resource_installation_id="$(docker_resource_label volume "$resource_id" com.backupsheep.installation-id)" \
                || die "could not inspect a Compose volume installation identity."
            if [[ -z "$resource_installation_id" ]]; then
                : # Legacy labels are immutable; the matching sentinel proves this project.
            else
                [[ "$resource_installation_id" == "$installation_id" ]] \
                    || die "Compose volume ${logical_name} belongs to a different BackupSheep installation."
            fi
        done
    fi
}

single_pinned_image_from_listing() {
    local image_listing="$1"
    local image_ref=""
    local candidate_image_ref=""
    local image_count=0

    while IFS= read -r candidate_image_ref; do
        [[ -n "$candidate_image_ref" ]] || continue
        image_count=$((image_count + 1))
        (( image_count == 1 )) \
            || return 1
        image_ref="$candidate_image_ref"
    done <<< "$image_listing"
    (( image_count == 1 )) \
        || return 1
    [[ "$image_ref" =~ ^[^[:space:]@]+:[^/[:space:]@]+@sha256:[0-9a-f]{64}$ ]] \
        || return 1
    printf '%s\n' "$image_ref"
}

