    if [[ "$rabbitmq_start_possible" != true ]]; then
        return 0
    fi

    container_listing="$(
        "${docker_command[@]}" ps --all --quiet \
            --filter "label=com.docker.compose.project=${project_name}"
    )" || die "could not inventory RabbitMQ containers; refusing startup."
    volume_listing="$(
        "${docker_command[@]}" volume ls --quiet \
            --filter "label=com.docker.compose.project=${project_name}"
    )" || die "could not inventory RabbitMQ volumes; refusing startup."

    while IFS= read -r resource_id; do
        [[ -n "$resource_id" ]] || continue
        logical_name="$(docker_resource_label container "$resource_id" com.docker.compose.service)" \
            || die "could not inspect a project container while proving RabbitMQ generation."
        if [[ "$logical_name" == "rabbitmq" ]]; then
            [[ -z "$rabbit_container_id" ]] \
                || die "multiple RabbitMQ containers claim this Compose project."
            rabbit_container_id="$resource_id"
        fi
    done <<< "$container_listing"
    while IFS= read -r resource_id; do
        [[ -n "$resource_id" ]] || continue
        logical_name="$(docker_resource_label volume "$resource_id" com.docker.compose.volume)" \
            || die "could not inspect a project volume while proving RabbitMQ generation."
        if [[ "$logical_name" == "rabbitmq_data" ]]; then
            [[ -z "$rabbit_volume_id" ]] \
                || die "multiple RabbitMQ data volumes claim this Compose project."
            rabbit_volume_id="$resource_id"
        fi
    done <<< "$volume_listing"

    if [[ -z "$rabbit_volume_id" ]]; then
        [[ -z "$rabbitmq_transition_target" ]] \
            || die "a RabbitMQ generation transition requires an existing broker data volume."
        if [[ -z "$rabbitmq_generation" && "$dry_run_requested" == false ]]; then
            set_env_value_atomically BACKUPSHEEP_RABBITMQ_DATA_GENERATION 4.3
            rabbitmq_generation="4.3"
        fi
        return
    fi

    if [[ -z "$rabbitmq_transition_target" ]]; then
        [[ "$rabbitmq_generation" == "4.3" ]] \
            || die "an existing RabbitMQ volume has no proven 4.3 generation; follow docs/guides/rabbitmq-upgrade.md."
        return
    fi

    [[ -z "$rabbitmq_generation" ]] \
        || die "a RabbitMQ transition is valid only while the installer generation witness is blank."
    [[ -n "$rabbit_container_id" ]] \
        || die "the RabbitMQ transition requires one live source-version container."
    container_state="$("${docker_command[@]}" inspect --format '{{.State.Status}}' "$rabbit_container_id")" \
        || die "could not inspect the source RabbitMQ container state."
    container_health="$("${docker_command[@]}" inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$rabbit_container_id")" \
        || die "could not inspect the source RabbitMQ container health."
    [[ "$container_state" == "running" && "$container_health" == "healthy" ]] \
        || die "the RabbitMQ generation transition requires a running healthy source broker."
    server_version="$(
        "${docker_command[@]}" exec --user rabbitmq "$rabbit_container_id" \
            rabbitmq-diagnostics -q server_version 2>/dev/null
    )" || die "could not query the source RabbitMQ server version as the broker identity."

    if [[ "$rabbitmq_transition_target" == "4.2" ]]; then
        [[ "$server_version" == 3.13.* ]] \
            || die "the reviewed 4.2 compatibility hop requires a healthy RabbitMQ 3.13 source."
        validate_enabled_rabbitmq_feature_flags "$rabbit_container_id" all disabled "the 3.13 to 4.2 pre-hop gate; Khepri enabled on 3.13 requires a blue-green migration"
    else
        [[ "$server_version" == "4.2.9" || "$server_version" == "4.3.5" ]] \
            || die "the reviewed 4.3 hop requires the exact healthy RabbitMQ 4.2.9 source or exact 4.3.5 reconciliation result."
        if [[ "$server_version" == "4.2.9" ]]; then
            validate_enabled_rabbitmq_feature_flags "$rabbit_container_id" all enabled "the RabbitMQ 4.3 pre-hop gate"
            expected_source_image="$(expected_pinned_rabbitmq_42_image)"
            attest_pinned_rabbitmq_container_image "$rabbit_container_id" "$expected_source_image"
        else
            validate_enabled_rabbitmq_feature_flags "$rabbit_container_id" required enabled "the RabbitMQ 4.3 reconciliation gate"
            # A prior 4.3 Compose recreation may have succeeded before the witness
            # write. Attest the exact pinned image before allowing a reconciliation
            # invocation to reach Compose, preventing an accidental newer-to-older hop.
            expected_source_image="$(expected_pinned_rabbitmq_image)"
            attest_pinned_rabbitmq_container_image "$rabbit_container_id" "$expected_source_image"
        fi
    fi
}

verify_and_record_completed_rabbitmq_43_transition() {
    local attempt=0
    local resource_id=""
    local rabbit_container_id=""
    local container_listing=""
    local logical_name=""
    local working_dir=""
    local config_files=""
    local expected_config_files="$base_file"
    local resource_installation_id=""
    local container_state=""
    local container_health=""
    local server_version=""
    local expected_image_ref=""

    if [[ "$approved_default" == true ]]; then
        expected_config_files+=",${default_override}"
    fi
    if [[ "$image_mode" == "signed-release" ]]; then
        expected_config_files+=",${release_overlay}"
    fi

    # Re-prove every project resource after Compose returns. This catches model,
    # path, logical-name, physical-name or identity drift across the recreation.
    validate_compose_project_ownership false

    while (( attempt < 60 )); do
        attempt=$((attempt + 1))
        rabbit_container_id=""
        container_listing="$(
            "${docker_command[@]}" ps --all --quiet \
                --filter "label=com.docker.compose.project=${project_name}"
        )" || die "could not inventory the completed RabbitMQ 4.3 transition."
        while IFS= read -r resource_id; do
            [[ -n "$resource_id" ]] || continue
            logical_name="$(docker_resource_label container "$resource_id" com.docker.compose.service)" \
                || die "could not inspect a post-transition project container."
            [[ "$logical_name" == "rabbitmq" ]] || continue
            [[ -z "$rabbit_container_id" ]] \
                || die "multiple RabbitMQ containers appeared after the 4.3 transition."
            rabbit_container_id="$resource_id"
        done <<< "$container_listing"

        if [[ -z "$rabbit_container_id" ]]; then
            sleep 1
            continue
        fi

        working_dir="$(docker_resource_label container "$rabbit_container_id" com.docker.compose.project.working_dir)" \
            || die "could not inspect the post-transition RabbitMQ working directory."
        config_files="$(docker_resource_label container "$rabbit_container_id" com.docker.compose.project.config_files)" \
            || die "could not inspect the post-transition RabbitMQ model."
        resource_installation_id="$(docker_resource_label container "$rabbit_container_id" com.backupsheep.installation-id)" \
            || die "could not inspect the post-transition RabbitMQ installation identity."
        [[ "$working_dir" == "$root_dir" \
            && "$config_files" == "$expected_config_files" \
            && "$resource_installation_id" == "$installation_id" ]] \
            || die "the post-transition RabbitMQ container was not recreated from the exact identified base model."

        container_state="$("${docker_command[@]}" inspect --format '{{.State.Status}}' "$rabbit_container_id")" \
            || die "could not inspect the post-transition RabbitMQ state."
        container_health="$("${docker_command[@]}" inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$rabbit_container_id")" \
            || die "could not inspect the post-transition RabbitMQ health."
        if [[ "$container_state" != "running" || "$container_health" != "healthy" ]]; then
            sleep 1
            continue
        fi

        server_version="$(
            "${docker_command[@]}" exec --user rabbitmq "$rabbit_container_id" \
                rabbitmq-diagnostics -q server_version 2>/dev/null
        )" || die "could not query the post-transition RabbitMQ server version."
        [[ "$server_version" == "4.3.5" ]] \
            || die "the post-transition broker is not the pinned RabbitMQ 4.3.5 target; the generation witness remains blank."
        expected_image_ref="$(expected_pinned_rabbitmq_image)"
        attest_pinned_rabbitmq_container_image "$rabbit_container_id" "$expected_image_ref"
        validate_enabled_rabbitmq_feature_flags "$rabbit_container_id" required enabled "the RabbitMQ 4.3 post-transition gate"

        set_env_value_atomically BACKUPSHEEP_RABBITMQ_DATA_GENERATION 4.3
        rabbitmq_generation="4.3"
        return 0
    done

    die "RabbitMQ did not become running and healthy after the 4.3 transition; the generation witness remains blank."
}

# Serialize every real mutation across this wrapper and install.sh. The atomic
# directory works on both GNU/Linux and macOS without a flock package. A crash can
# deliberately leave a stale fail-closed lock; it is never guessed away from a PID.
# Read-only commands and structural Compose dry-runs remain concurrent.
if [[ "$mutating_command" == true && "$dry_run_requested" == false ]]; then
    acquire_mutation_lock
fi

# Validate the same fully rendered model immediately before every read or mutation.
assert_installation_ancestor_identity
assert_installation_root_identity
"${compose_command[@]}" config --quiet
ownership_required="$mutating_command"
case "$compose_subcommand" in
    events|images|logs|port|ps|stats|top|volumes|wait) ownership_required=true ;;
esac
if [[ "$mutating_command" == true && "$rabbitmq_transition_target" == 4.3 ]]; then
    # Prove the target model before source-container inspection so an approved
    # storage override cannot substitute a different broker image and hide
    # behind a later source-generation error.
    expected_pinned_rabbitmq_image >/dev/null
fi
if [[ "$ownership_required" == true ]]; then
    validate_compose_project_ownership "$volume_deletion_requested"
fi
if [[ "$mutating_command" == true ]]; then
    validate_rabbitmq_data_generation
fi
if [[ "$dry_run_requested" == false ]]; then
    if [[ "$compose_subcommand" == "down" \
          || "$egress_pair_recreation_requested" == true ]]; then
        refuse_existing_egress_oneoffs
    elif [[ "$compose_subcommand" == "run" ]]; then
        case "$run_service" in
            app|worker-cloud|worker-database|worker-files|worker-storage|worker-logs)
                refuse_existing_egress_oneoffs
                ;;
        esac
    fi
fi
if [[ "$compose_subcommand" == "run" && "$dry_run_requested" == false ]]; then
    case "$run_service" in
        app|worker-cloud|worker-database|worker-files|worker-storage|worker-logs)
            attest_current_egress_guard_for_run "$run_service"
            ;;
    esac
fi
if [[ "$compose_subcommand" == "up" && "$up_broad_project" == true \
      && "$dry_run_requested" == false ]]; then
    existing_project_containers="$(
        "${docker_command[@]}" ps --all --quiet \
            --filter "label=com.docker.compose.project=${project_name}"
    )" || die "could not inventory an existing egress lifecycle before broad up."
    while IFS= read -r existing_container; do
        [[ -n "$existing_container" ]] || continue
        existing_service="$(docker_resource_label \
            container "$existing_container" com.docker.compose.service)" \
            || die "could not inspect an existing egress lifecycle before broad up."
        case "$existing_service" in
            app-egress-guard|app|cloud-egress-guard|worker-cloud|\
            database-egress-guard|worker-database|files-egress-guard|worker-files|\
            storage-egress-guard|worker-storage|logs-egress-guard|worker-logs)
                die "broad up cannot change an existing egress lifecycle; force-recreate each exact guard/workload pair with --no-deps."
                ;;
        esac
    done <<< "$existing_project_containers"
fi
assert_installation_ancestor_identity
assert_installation_root_identity
run_compose_in_isolated_group "${compose_command[@]}" "${compose_arguments[@]}"
assert_installation_ancestor_identity
assert_installation_root_identity
if [[ "$dry_run_requested" == false ]]; then
    case "$compose_subcommand" in
        up|create)
            # Compose may adopt or create resources after the preflight inventory.
            # Re-attest the complete resulting project before returning success.
            validate_compose_project_ownership false
            ;;
    esac
fi
if [[ "$rabbitmq_transition_target" == "4.3" ]]; then
    verify_and_record_completed_rabbitmq_43_transition
fi
