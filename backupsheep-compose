            expected_binds+="${root_dir}/deploy/rabbitmq/90-backupsheep.conf:/etc/rabbitmq/conf.d/90-backupsheep.conf:ro"$'\n'
            expected_binds+="${root_dir}/deploy/rabbitmq/entrypoint.sh:/usr/local/bin/backupsheep-rabbitmq-entrypoint:ro"$'\n'
            expected_binds+="${root_dir}/deploy/rabbitmq/volume-init.sh:/usr/local/bin/backupsheep-rabbitmq-volume-init:ro"$'\n'
            ;;
        rabbitmq-provision)
            expected_binds+="${root_dir}/deploy/rabbitmq/provision.sh:/usr/local/bin/backupsheep-rabbitmq-provision:ro"$'\n'
            ;;
    esac
    expected_binds="$(printf '%s' "$expected_binds" | LC_ALL=C sort)"
    actual_binds="$("${docker_command[@]}" inspect --format \
        '{{range .HostConfig.Binds}}{{println .}}{{end}}' "$container_id" | LC_ALL=C sort)" \
        || die "could not inspect ${service} exact bind-create policy."
    [[ "$actual_binds" == "$expected_binds" ]] \
        || die "Compose service ${service} bind-create source, target, or option set drifted."

    # All named volumes use the long Compose mount syntax with nocopy:true.
    # Bind mounts remain in HostConfig.Binds; therefore every HostConfig.Mounts
    # entry must be one of these exact volume records and must retain NoCopy.
    host_mounts="$("${docker_command[@]}" inspect --format \
        '{{range .HostConfig.Mounts}}{{printf "%s|%s|%s|%t|" .Type .Source .Target .ReadOnly}}{{if .VolumeOptions}}{{printf "true|%t|%s|%d|" .VolumeOptions.NoCopy .VolumeOptions.Subpath (len .VolumeOptions.Labels)}}{{if .VolumeOptions.DriverConfig}}true{{else}}false{{end}}{{else}}false|false||-1|false{{end}}{{printf "|"}}{{if .BindOptions}}true{{else}}false{{end}}{{printf "|"}}{{if .TmpfsOptions}}true{{else}}false{{end}}{{printf "|"}}{{if .ClusterOptions}}true{{else}}false{{end}}{{printf "|"}}{{if .ImageOptions}}true{{else}}false{{end}}{{println}}{{end}}' \
        "$container_id")" || die "could not inspect ${service} Docker mount-create policy."
    while IFS='|' read -r mount_type source destination read_only volume_options no_copy volume_subpath \
        volume_label_count driver_config bind_options tmpfs_options cluster_options image_options; do
        [[ -n "$mount_type$source$destination$read_only$volume_options$no_copy$volume_subpath$volume_label_count$driver_config$bind_options$tmpfs_options$cluster_options$image_options" ]] || continue
        host_mount_count=$((host_mount_count + 1)); (( host_mount_count <= 16 )) \
            || die "Compose service ${service} has too many Docker mount-create records."
        [[ "$mount_type" == volume && "$source" == "${project_name}_"* \
            && "$destination" == /* && "$read_only" =~ ^(true|false)$ \
            && "$volume_options" == true && "$no_copy" == true && -z "$volume_subpath" \
            && "$volume_label_count" == 0 && "$driver_config" == false \
            && "$bind_options" == false && "$tmpfs_options" == false \
            && "$cluster_options" == false && "$image_options" == false ]] \
            || die "Compose service ${service} has unsafe mount-create volume, NoCopy, subpath, label, driver, bind, tmpfs, cluster, or image options."
        expected_rw=true; [[ "$read_only" == true ]] && expected_rw=false
        expected_mountpoint="$(printf '%s\n' "$volume_mountpoint_map" | awk -F'|' -v physical="$source" '$1 == physical { if (found++) exit 9; value=$2 } END { if (found == 1) print value; else exit 8 }')" \
            || die "Compose service ${service} mount-create source is not an inspected owned volume."
        grep -Fxq -- "volume|${source}|${expected_mountpoint}|${destination}|${expected_rw}||" <<< "$mounts" \
            || die "Compose service ${service} mount-create policy disagrees with its runtime mount."
    done <<< "$host_mounts"
    case "$service" in
        db|rabbitmq-volume-init|rabbitmq|rabbitmq-provision|app) expected_host_mount_count=1 ;;
        staging-provision) expected_host_mount_count=9 ;;
        worker-database|worker-files) expected_host_mount_count=3 ;;
        worker-storage) expected_host_mount_count=5 ;;
        *) expected_host_mount_count=0 ;;
    esac
    [[ "$host_mount_count" == "$expected_host_mount_count" ]] \
        || die "Compose service ${service} named-volume NoCopy set is incomplete or has extra entries."

    actual_tmpfs="$("${docker_command[@]}" inspect --format \
        '{{range $path, $options := .HostConfig.Tmpfs}}{{printf "%s|%s\n" $path $options}}{{end}}' \
        "$container_id" | LC_ALL=C sort)" \
        || die "could not inspect ${service} tmpfs option strings."
    case "$service" in
        db) expected_tmpfs="/tmp|rw,noexec,nosuid,nodev,size=$(env_value_or_default POSTGRES_TMPFS_SIZE 128m),mode=1777"$'\n''/var/run/postgresql|rw,noexec,nosuid,nodev,size=16m,mode=3775,uid=70,gid=70' ;;
        rabbitmq-volume-init) expected_tmpfs='/tmp|rw,noexec,nosuid,nodev,size=8m,mode=1777' ;;
        rabbitmq) expected_tmpfs="/run/backupsheep-rabbitmq|rw,noexec,nosuid,nodev,size=1m,mode=0700,uid=100,gid=101"$'\n'"/tmp|rw,noexec,nosuid,nodev,size=$(env_value_or_default RABBITMQ_TMPFS_SIZE 128m),mode=1777"$'\n''/var/log/rabbitmq|rw,noexec,nosuid,nodev,size=64m,mode=0750,uid=100,gid=101' ;;
        rabbitmq-provision) expected_tmpfs='/tmp|rw,noexec,nosuid,nodev,size=32m,mode=1777' ;;
        staging-provision) expected_tmpfs='/tmp|rw,noexec,nosuid,nodev,size=16m,mode=1777' ;;
        *-egress-guard) expected_tmpfs='/run/backupsheep-egress|rw,noexec,nosuid,nodev,size=1m,mode=0700,uid=0,gid=0' ;;
        app) expected_tmpfs="/run/backupsheep|rw,noexec,nosuid,nodev,size=16m,mode=0700,uid=10001,gid=10001"$'\n'"/tmp|rw,noexec,nosuid,nodev,size=$(env_value_or_default BACKUPSHEEP_TMPFS_SIZE 256m),mode=1777" ;;
        worker-cloud) expected_tmpfs="/run/backupsheep|rw,noexec,nosuid,nodev,size=16m,mode=0700,uid=10008,gid=10008"$'\n'"/tmp|rw,noexec,nosuid,nodev,size=$(env_value_or_default BACKUPSHEEP_TMPFS_SIZE 256m),mode=1777" ;;
        worker-database) expected_tmpfs="/run/backupsheep|rw,noexec,nosuid,nodev,size=16m,mode=0700,uid=10002,gid=10002"$'\n'"/tmp|rw,noexec,nosuid,nodev,size=$(env_value_or_default BACKUPSHEEP_TMPFS_SIZE 256m),mode=1777" ;;
        worker-files) expected_tmpfs="/run/backupsheep|rw,noexec,nosuid,nodev,size=16m,mode=0700,uid=10003,gid=10003"$'\n'"/tmp|rw,noexec,nosuid,nodev,size=$(env_value_or_default BACKUPSHEEP_TMPFS_SIZE 256m),mode=1777" ;;
        worker-storage) expected_tmpfs="/run/backupsheep|rw,noexec,nosuid,nodev,size=16m,mode=0700,uid=10004,gid=10004"$'\n'"/tmp|rw,noexec,nosuid,nodev,size=$(env_value_or_default BACKUPSHEEP_TMPFS_SIZE 256m),mode=1777" ;;
        worker-logs) expected_tmpfs="/run/backupsheep|rw,noexec,nosuid,nodev,size=16m,mode=0700,uid=10005,gid=10005"$'\n'"/tmp|rw,noexec,nosuid,nodev,size=$(env_value_or_default BACKUPSHEEP_TMPFS_SIZE 256m),mode=1777" ;;
        beat) expected_tmpfs="/run/backupsheep|rw,noexec,nosuid,nodev,size=16m,mode=0700,uid=10006,gid=10006"$'\n'"/tmp|rw,noexec,nosuid,nodev,size=$(env_value_or_default BACKUPSHEEP_TMPFS_SIZE 256m),mode=1777" ;;
        db-provision|migrate|db-seal|preflight) expected_tmpfs="/run/backupsheep|rw,noexec,nosuid,nodev,size=16m,mode=0700,uid=10007,gid=10007"$'\n'"/tmp|rw,noexec,nosuid,nodev,size=$(env_value_or_default BACKUPSHEEP_TMPFS_SIZE 256m),mode=1777" ;;
    esac
    expected_tmpfs="$(printf '%s\n' "$expected_tmpfs" | LC_ALL=C sort)"
    [[ "$actual_tmpfs" == "$expected_tmpfs" ]] \
        || die "Compose service ${service} tmpfs targets or security options drifted."
}

validate_compose_model_settings

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 -r "$1" | awk '{print $1}'
    else
        die "sha256sum, shasum, or openssl is required to attest signed-release evidence."
    fi
}

git_client() {
    /usr/bin/env -i LC_ALL=C LANG=C HOME=/ PATH=/usr/local/bin:/usr/bin:/bin \
        GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 \
        GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false GIT_ALLOW_PROTOCOL=https \
        "$git_bin" -c core.hooksPath=/dev/null -c init.templateDir=/dev/null \
        -c http.sslVerify=true -c core.fsmonitor=false -c core.untrackedCache=false \
        -c diff.external= "$@"
}

validate_signed_release_source_checkout() {
    local top="" git_dir="" head="" origins="" relative="" path=""
    git_bin="$(command -v git || true)"
    [[ "$git_bin" == /* && -x "$git_bin" ]] \
        || die "git is required to attest signed-release runtime files."
    [[ -d "$root_dir/.git" && ! -L "$root_dir/.git" ]] \
        || die "signed-release operations require the installer-managed Git checkout."
    top="$(git_client -C "$root_dir" rev-parse --show-toplevel)" \
        || die "could not resolve signed-release checkout."
    git_dir="$(git_client -C "$root_dir" rev-parse --absolute-git-dir)" \
        || die "could not resolve signed-release Git directory."
    [[ "$top" == "$root_dir" && "$git_dir" == "$root_dir/.git" ]] \
        || die "signed-release checkout escapes the installation directory."
    head="$(git_client -C "$root_dir" rev-parse --verify 'HEAD^{commit}')" \
        || die "could not resolve signed-release checkout HEAD."
    [[ "$head" == "$release_commit" ]] \
        || die "signed-release checkout HEAD does not match its release receipt."
    origins="$(git_client -C "$root_dir" remote get-url --all origin)" \
        || die "could not attest signed-release checkout origin."
    [[ "$origins" == "https://github.com/bilal414/backupsheep.git" ]] \
        || die "signed-release checkout origin is not official."
    git_client -C "$root_dir" fsck --strict --no-dangling >/dev/null \
        || die "signed-release checkout object verification failed."
    git_client -C "$root_dir" diff --no-ext-diff --no-textconv --quiet -- \
        || die "signed-release checkout has modified tracked runtime files."
    git_client -C "$root_dir" diff --cached --no-ext-diff --no-textconv --quiet -- \
        || die "signed-release checkout has staged runtime changes."
    for relative in \
        backupsheep-compose \
        docker-compose.yml \
        deploy/release/signed-release.compose.yml \
        deploy/rabbitmq/upgrade-4.2.9.compose.yml \
        deploy/rabbitmq/volume-init.sh \
        deploy/rabbitmq/90-backupsheep.conf \
        deploy/rabbitmq/entrypoint.sh \
        deploy/rabbitmq/provision.sh \
        deploy/runtime/compose-json.awk \
        scripts/release_transition.py \
        scripts/signed_release_upgrade.py \
        deploy/release-policy.json; do
        path="$root_dir/$relative"
        validate_private_file "$path" "signed-release runtime file ${relative}"
        git_client -C "$root_dir" show "${release_commit}:${relative}" | cmp -s - "$path" \
            || die "signed-release runtime file does not byte-match its source commit: ${relative}."
    done
    for path in "$base_file" "$release_overlay" "$rabbitmq_upgrade"; do
        ! grep -Eq '^[[:space:]]*(use_api_socket|provider|develop|post_start|pre_stop|extends|include|devices|device_cgroup_rules|configs):[[:space:]]' "$path" \
            || die "signed-release Compose source contains a forbidden host or lifecycle extension."
        ! grep -Eq '^[[:space:]]*privileged:[[:space:]]*true([[:space:]]|$)' "$path" \
            || die "signed-release Compose source contains a privileged service."
        ! grep -Eq '^[[:space:]]*(network_mode|pid|ipc|cgroup):[[:space:]]*["'\'']?host(["'\'']?[[:space:]]*)$' "$path" \
            || die "signed-release Compose source shares a host namespace."
    done
}

release_evidence_value() {
    local path="$1"
    local key="$2"
    local count=""
    local value=""
    count="$(awk -v prefix="${key}=" 'index($0, prefix) == 1 { count++ } END { print count + 0 }' "$path")"
    [[ "$count" == "1" ]] || die "signed-release evidence key ${key} is absent or duplicated."
    value="$(awk -v prefix="${key}=" 'index($0, prefix) == 1 { print substr($0, length(prefix) + 1) }' "$path")"
    [[ -n "$value" && "$value" != *$'\n'* && "$value" != *$'\r'* ]] \
        || die "signed-release evidence key ${key} is malformed."
    printf '%s' "$value"
}

