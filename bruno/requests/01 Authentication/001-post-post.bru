meta {
  name: POST /api/v1/auth/login/
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.getStatus() >= 200 && res.getStatus() < 300) {
    const payload = res.getBody();
    if (payload && payload.api_key) {
      bru.setVar("apiToken", String(payload.api_key));
    }
  }
}

tests {
  test("request does not fail with an unhandled server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}

docs {
  Operation ID: `post-api-v1-auth-login`

  No authentication required. Authentication request; stores the returned token in memory only.

  Django action: `apps.api.v1.auth.views.APIAuthLogin.post`
  Source: `apps/api/v1/auth/views.py`
}
