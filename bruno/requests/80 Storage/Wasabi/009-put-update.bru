meta {
  name: PUT /api/v1/storage/wasabi/{{resourceId}}/
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/api/v1/storage/wasabi/{{resourceId}}/
  body: json
  auth: none
}

headers {
  Authorization: Token {{apiToken}}
  Content-Type: application/json
}

body:json {
  {
    "storage_wasabi": {
      "region": "replace-with-region-id",
      "access_key": "{{providerCredential}}",
      "secret_key": "{{providerCredential}}",
      "bucket_name": "backup-example"
    },
    "name": "Example resource"
  }
}

script:pre-request {
  if (String(bru.getEnvVar("allowMutations")) !== "true") {
    throw new Error("Blocked by default: set allowMutations=true only after reviewing this exact request.");
  }
}

tests {
  test("request does not fail with an unhandled server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}

docs {
  Operation ID: `put-api-v1-storage-wasabi-resourceid`

  Requires `Authorization: Token <key>`. State-changing request; blocked unless `allowMutations=true`.

  Django action: `apps.api.v1.storage.wasabi.views.CoreStorageWasabiView.update`
  Source: `apps/api/v1/storage/wasabi/views.py`
}
