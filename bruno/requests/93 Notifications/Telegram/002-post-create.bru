meta {
  name: POST /api/v1/notifications-telegram/
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/notifications-telegram/
  body: json
  auth: none
}

headers {
  Authorization: Token {{apiToken}}
  Content-Type: application/json
}

body:json {
  {
    "channel_name": "replace-with-channel-name",
    "chat_id": "replace-with-chat-id"
  }
}

script:pre-request {
  if (String(bru.getEnvVar("allowMutations")) !== "true") {
    throw new Error("Blocked by default: set allowMutations=true only after reviewing this exact request.");
  }
}

tests {
  test("request does not fail with an unhandled server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}

docs {
  Operation ID: `post-api-v1-notifications-telegram`

  Requires `Authorization: Token <key>`. State-changing request; blocked unless `allowMutations=true`.

  Django action: `apps.api.v1.notification.views.CoreNotificationTelegramView.create`
  Source: `apps/api/v1/notification/views.py`
}
