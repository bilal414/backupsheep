meta {
  name: POST /api/v1/utils/ssh-host-keys/approve/
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/utils/ssh-host-keys/approve/
  body: json
  auth: none
}

headers {
  Authorization: Token {{apiToken}}
  Content-Type: application/json
}

body:json {
  {
    "approval_token": "{{sshApprovalToken}}",
    "fingerprint": "{{sshFingerprint}}",
    "replace": false
  }
}

script:pre-request {
  if (String(bru.getEnvVar("allowMutations")) !== "true") {
    throw new Error("Blocked by default: set allowMutations=true only after reviewing this exact request.");
  }
}

tests {
  test("request does not fail with an unhandled server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}

docs {
  Operation ID: `post-api-v1-utils-ssh-host-keys-approve`

  Requires `Authorization: Token <key>`. State-changing request; blocked unless `allowMutations=true`.

  Django action: `apps.api.v1.utils.views.SSHHostKeyApproveView.post`
  Source: `apps/api/v1/utils/views.py`
}
