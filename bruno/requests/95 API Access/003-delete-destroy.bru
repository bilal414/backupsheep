meta {
  name: DELETE /api/v1/oauth/applications/{{resourceId}}/
  type: http
  seq: 3
}

delete {
  url: {{baseUrl}}/api/v1/oauth/applications/{{resourceId}}/
  body: none
  auth: none
}

headers {
  Authorization: Token {{apiToken}}
}

script:pre-request {
  if (String(bru.getEnvVar("allowMutations")) !== "true") {
    throw new Error("Blocked by default: set allowMutations=true only after reviewing this exact request.");
  }
}

tests {
  test("request does not fail with an unhandled server error", function () {
    expect(res.getStatus()).to.be.below(500);
  });
}

docs {
  Operation ID: `delete-api-v1-oauth-applications-resourceid`

  Requires the console session or the legacy login token (`Authorization: Token <key>`); personal API tokens and OAuth access tokens are rejected so a scoped credential can never mint a broader one. State-changing request; blocked unless `allowMutations=true`.

  Django action: `apps.api.v1.oauth.views.OAuthApplicationViewSet.destroy`
  Source: `apps/api/v1/oauth/views.py`
}
