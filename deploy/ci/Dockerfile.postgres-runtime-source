# fixture is never published or used by the application; the release-blocking E2E
# gate uses it solely to build witnessed generation-2 and generation-3 volumes.
FROM postgres:18.6-trixie@sha256:06cad38a5d9f5d24b4d83d86def30795d5e4b757fedbf5281172b576dedcd941

LABEL com.backupsheep.postgres.runtime-migration-source-fixture="18.6-trixie-glibc-uid999-v1" \
      com.backupsheep.postgres.source-base-index-digest="sha256:06cad38a5d9f5d24b4d83d86def30795d5e4b757fedbf5281172b576dedcd941"

RUN set -eux; \
    printf '%s  %s\n' 9c440299ae04a0a79d55b8bf03307036d890a40979d2fb698073c9050d4b20a5 /usr/local/bin/docker-entrypoint.sh \
        | sha256sum --check --strict -; \
    test "$(id -u postgres):$(id -g postgres)" = '999:999'

USER 999:999
