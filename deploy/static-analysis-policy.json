  "reviews": {
    "bound-placeholder-list": "The dynamic SQLite fragment contains only a generated count of question-mark placeholders; all values are parameter-bound.",
    "docker-preflight-fixed-runtime-paths": "Fixed /tmp and /run probe roots are ownership-, mode-, type-, and tmpfs-validated; private scratch files use tempfile.",
    "fixed-client-argv-execution": "The generic subprocess wrapper receives only fixed database-client executables and validated, argument-vector builders without a shell.",
    "fixed-github-api-requests": "Release evidence requests use fixed HTTPS GitHub API/upload origins derived from validated repository and release identifiers.",
    "fixed-lane-probe-sql": "The isolation probe uses fixed statements and internal allowlists to verify database-lane behavior; no untrusted SQL is accepted.",
    "ftps-and-explicit-legacy-ftp-module": "The standard-library module is required for FTP_TLS. Its plaintext subclass checks the default-off ALLOW_INSECURE_FTP compatibility gate before connect or login, and tests prove disabled mode performs no network access.",
    "non-bind-zero-address-check": "This is a provider-response string comparison against the IPv4 unspecified-address sentinel, not a socket bind.",
    "non-sql-log-message": "The flagged strings are structured execution log messages and are never submitted to a database engine.",
    "owned-harness-temporary-paths": "Remote temporary names contain a strictly validated run identifier and exist only on an owned disposable test instance.",
    "provider-address-http-probe": "The scheme is a fixed http literal and the address comes from the authenticated EC2 instance record for a disposable reachability probe.",
    "validated-aws-fixture-sql": "The disposable AWS fixture accepts strict lowercase SQL identifiers, escapes literals, and shell-quotes complete psql statements.",
    "validated-harness-remote-commands": "The remote command primitive is used only with constants or strict validation plus shlex quoting in the safety-gated disposable harness.",
    "validated-lane-policy-sql": "Lane-policy SQL combines module-owned statements with strict identifier/literal validators and no request-controlled SQL fragments.",
    "validated-restore-sql": "Restore SQL uses allowlisted dialects, strictly validated identifiers, and escaping helpers at each dynamic identifier or literal boundary.",
    "validated-upcloud-fixture-sql": "Disposable fixture and cleanup SQL uses generated values or strict lowercase identifier and fixed-width hex validators.",
    "website-shlex-remote-commands": "Remote tar commands use strict input validation, shlex quoting, and explicit option terminators before operands."
  },
